   ],
   "to": "AwaitingLegal",
   "permission": "variations.create",
   "role": "resubmitLegal"
  },
  {
   "code": "PrepareAfterLegal",
   "display": "Prepare for signature",
   "from": [
    "LegalCleared"
   ],
   "to": "Prepared",
   "permission": "variations.create",
   "role": "plain"
  },
  {
   "code": "SendForSignature",
