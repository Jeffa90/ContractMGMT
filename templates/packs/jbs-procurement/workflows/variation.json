  {
   "code": "Cancelled",
   "display": "Cancelled",
   "role": "cancelled",
   "locked": false,
   "freezeContent": false,
   "documentPolicy": "Open",
   "terminal": true
  }
 ],
 "transitions": [
  {
   "code": "SubmitForLegal",
   "display": "Submit for Legal",
   "from": [
    "Draft"
   ],
   "to": "AwaitingLegal",
   "permission": "variations.create",
   "role": "submitLegal",
   "guards": [
    "LegalRequired",
    "RequiredFieldsPresent"
   ]
  },
  {
   "code": "ProceedWithoutLegal",
   "display": "Prepare for signature",
   "from": [
    "Draft"
   ],
   "to": "Prepared",
   "permission": "variations.create",
   "role": "plain",
   "guards": [
    "LegalNotRequired",
    "RequiredFieldsPresent"
   ]
  },
  {
   "code": "RecallFromLegal",
   "display": "Recall from Legal",
   "from": [
    "AwaitingLegal"
   ],
   "to": "Draft",
   "permission": "variations.create",
   "role": "recallLegal",
   "guards": [
    "ReasonRequired"
   ],
   "reasonRequired": true
  },
  {
   "code": "BeginLegalReview",
