<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Ecp.Host</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ecp.SharedKernel/Ecp.SharedKernel.csproj" />
    <ProjectReference Include="../Ecp.Persistence/Ecp.Persistence.csproj" />
    <ProjectReference Include="../Modules/Ecp.Tenancy/Ecp.Tenancy.csproj" />
    <ProjectReference Include="../Modules/Ecp.Audit/Ecp.Audit.csproj" />
    <ProjectReference Include="../Modules/Ecp.Identity/Ecp.Identity.csproj" />
    <ProjectReference Include="../Modules/Ecp.Configuration/Ecp.Configuration.csproj" />
    <ProjectReference Include="../Modules/Ecp.Contracts/Ecp.Contracts.csproj" />
    <ProjectReference Include="../Modules/Ecp.Documents/Ecp.Documents.csproj" />
    <ProjectReference Include="../Modules/Ecp.DataMigration/Ecp.DataMigration.csproj" />
    <ProjectReference Include="../Modules/Ecp.Lifecycle/Ecp.Lifecycle.csproj" />
    <ProjectReference Include="../Modules/Ecp.Approvals/Ecp.Approvals.csproj" />
    <ProjectReference Include="../Modules/Ecp.Notifications/Ecp.Notifications.csproj" />
    <ProjectReference Include="../Modules/Ecp.Operations/Ecp.Operations.csproj" />
    <ProjectReference Include="../Modules/Ecp.Setup/Ecp.Setup.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Synthetic Demo data: one canonical copy under sample-data/. Used only when Demo seeding is enabled (refused in Production). -->
    <EmbeddedResource Include="../../sample-data/demo-organisation-structure.json" LogicalName="Ecp.Demo.organisation-structure.json" />
    <EmbeddedResource Include="../../sample-data/demo-users-and-roles.json" LogicalName="Ecp.Demo.users-and-roles.json" />
    <EmbeddedResource Include="../../sample-data/demo-categories-and-assignments.json" LogicalName="Ecp.Demo.categories-and-assignments.json" />
    <EmbeddedResource Include="../../sample-data/demo-contracts.json" LogicalName="Ecp.Demo.contracts.json" />
  </ItemGroup>
</Project>
