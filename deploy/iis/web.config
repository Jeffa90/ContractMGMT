<?xml version="1.0" encoding="utf-8"?>
<!-- Windows Server / IIS (ASP.NET Core Module, in-process). Status: Scaffolded / Not Verified (no Windows/IIS in the build workspace).
     Publish:  dotnet publish src/Ecp.Host/Ecp.Host.csproj -c Release -o publish
     Requires the .NET 10 Hosting Bundle. Secrets are NOT set here: use machine-level environment variables or file/DPAPI secret references. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Ecp.Host.dll" stdoutLogEnabled="false" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="Ecp__Mode" value="Production" />
          <environmentVariable name="Ecp__DemoTenantResolution" value="false" />
          <environmentVariable name="Ecp__DemoSeed" value="false" />
          <environmentVariable name="Ecp__DataDirectory" value="D:\EcpData" />
          <environmentVariable name="Database__Provider" value="SqlServer" />
          <environmentVariable name="Database__ConnectionStringRef" value="file:D:\EcpSecrets\sql-connection.txt" />
          <environmentVariable name="Database__AutoMigrate" value="false" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
