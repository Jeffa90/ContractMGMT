# Enterprise Contract Platform: example environment
#
# This file lists the names of settings only. It contains NO secrets and NO real values.
# Copy to `.env` for local Demo use (`.env` is git-ignored). Never commit real values.
# In Production, secrets come from the secret provider (Docker secrets, Azure Key Vault,
# or a DPAPI-protected file). The setup wizard validates references; it does not accept
# or display secret values in Production (requirements/12-operations/SETUP_AND_READINESS_SPEC.md).
#
# Status: names are provisional until the host is implemented (TASKS.md FND-04, SET-01).

# Mode: Demo | Test | Production. Production refuses Demo identity and default credentials.
ECP_MODE=Demo

# Deployment model hint: Docker | IIS | Azure
ECP_DEPLOYMENT_MODEL=Docker

# Host role: all | web | worker
ECP_HOST_ROLE=all

# Persistent data directory (documents, bootstrap store, key ring). Must be a persistent volume.
ECP_DATA_DIR=/data

# Secret references (never values). Supported schemes: env: file: keyvault: dpapi:
# Example: ECP_DB_CONNECTION_REF=env:ECP_DB_CONNECTION
ECP_DB_CONNECTION_REF=

# Setup access: loopback only by default. A host-level allowlist may be set here (CIDR list).
ECP_SETUP_ALLOWED_NETWORKS=

# Test SQL Server (docs/TESTING.md section 3, option C). Leave empty if not used.
ECP_TEST_SQL=

# Notifications (lifecycle slice). Names only; SMTP user and password are secret REFERENCES, never values.
# Email provider: demo-log | dev-capture | smtp | graph. Production accepts only smtp or graph (graph is a scaffold).
# Notifications__EmailProvider=dev-capture
# Notifications__BaseUrl=https://contracts.example.test
# Notifications__Smtp__Provider=Smtp
# Notifications__Smtp__Host=smtp.example.test
# Notifications__Smtp__Port=587
# Notifications__Smtp__UseTls=true
# Notifications__Smtp__From=noreply@example.test
# Notifications__Smtp__UserRef=env:ECP_SMTP_USER
# Notifications__Smtp__PasswordRef=env:ECP_SMTP_PASSWORD
# Seconds between background runs per tenant (0 turns the timer off; the work can still be run from the administration page).
# Notifications__JobIntervalSeconds=60
