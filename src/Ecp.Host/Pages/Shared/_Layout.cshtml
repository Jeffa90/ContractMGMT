@using System.Globalization
@using Ecp.Identity
@using Ecp.SharedKernel
@inject IAccessService Access
@inject EcpHostOptions HostOptions
@inject Ecp.Host.Setup.BrandingAccessor Brand
@inject Ecp.Identity.ElevationContext Elevation
@inject Ecp.SharedKernel.PreviewContext PreviewCtx
@inject Ecp.Host.Navigation.NavigationService Navigation
@inject Ecp.Operations.IMaintenanceService Maintenance
@{
    var branding = await Brand.GetAsync();
    var productName = branding.ProductName == Ecp.Configuration.Branding.Default.ProductName ? Terms.Singular("application.name") : branding.ProductName;
    var title = ViewData["Title"] as string ?? productName;
    var path = Context.Request.Path.Value ?? "/";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var maintenanceOn = false;
    try { maintenanceOn = (await Maintenance.GetAsync()).Enabled; } catch (Exception) { /* the flag cannot be read; readiness reports it */ }
    Ecp.Host.Navigation.NavigationModel? nav = null;
    if (signedIn) nav = await Navigation.GetAsync(Context.RequestAborted);
    bool Current(string match) => match == "/" ? path == "/" : path.StartsWith(match, StringComparison.OrdinalIgnoreCase);
    // Breadcrumb for administration pages: Administration > group > page, from the same catalogue that builds the menu.
    (Ecp.Host.Navigation.AdminSection Section, Ecp.Host.Navigation.NavItem Item)? crumb = null;
    if (nav is not null && path.Length > 1)
    {
        foreach (var section in nav.Administration)
            foreach (var item in section.Items)
                if (Current(item.Match) && (crumb is null || item.Match.Length > crumb.Value.Item.Match.Length)) crumb = (section, item);
    }
}
<!DOCTYPE html>
<html lang="@(string.IsNullOrEmpty(CultureInfo.CurrentUICulture.Name) ? "en" : CultureInfo.CurrentUICulture.Name)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@title - @productName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/branding.css" />
</head>
<body>
    <a class="skip-link" href="#main">@L["Skip to main content"]</a>
    @if (PreviewCtx.Active)
    {
        <div class="access-banner preview-banner" role="alert">
            <strong>@L["TEST MODE"] — @L["Previewing as"] @PreviewCtx.TargetName</strong>
            <span>@L["Read-only"] · @L["ends in {0} min", Math.Max(0, (int)Math.Ceiling((PreviewCtx.ExpiresUtc - DateTime.UtcNow).TotalMinutes))]</span>
            <form method="post" action="/Account/ExitPreview"><button type="submit">@L["Exit user preview"]</button></form>
        </div>
    }
    @if (HostOptions.Mode != EcpMode.Production)
    {
        <div class="env-banner" role="status">@L["Demonstration environment"] (@HostOptions.Mode): @L["synthetic data only, not for production use."]</div>
    }
    @if (maintenanceOn)
    {
        <div class="access-banner" role="alert"><strong>@L["The system is in maintenance."]</strong> @L["Changes are paused until an operator ends maintenance."]</div>
    }
    @if (Elevation.Current is { } elevated)
    {
        <div class="access-banner" role="alert">
            <strong>@L["Support access is active"]</strong>
            (@elevated.Kind, @L["until"] @Fmt.DateTime(elevated.ExpiresUtc)): @elevated.Reason
            <form method="post" asp-page="/Account/EndAccess"><button type="submit" class="secondary">@L["End this access"]</button></form>
        </div>
    }
    <header class="site-header">
        <a class="brand" href="/">@productName</a>
        @if (nav is not null)
        {
            <nav aria-label="@L["Main"]">
                <ul class="primary">
                    @foreach (var item in nav.Primary)
                    {
                        <li><a href="@item.Href" aria-current="@(Current(item.Match) ? "page" : null)">@L[item.Text]</a></li>
                    }
                    @if (nav.HasAdministration)
                    {
                        <li class="admin-menu">
                            <details id="admin-menu" @(crumb is not null ? "data-here" : "")>
                                <summary>@L["Administration"]</summary>
                                <div class="admin-panel">
                                    <p><a href="/Admin">@L["All administration"]</a></p>
                                    @foreach (var grp in nav.Administration)
                                    {
                                        <section aria-labelledby="menu-@grp.Key">
                                            <h2 id="menu-@grp.Key" class="menu-heading">@L[grp.Title]</h2>
                                            <ul>
                                                @foreach (var item in grp.Items)
                                                {
                                                    <li><a href="@item.Href" aria-current="@(crumb is { } c && c.Item.Key == item.Key ? "page" : null)">@L[item.Text]</a></li>
                                                }
                                            </ul>
                                        </section>
                                    }
                                </div>
                            </details>
                        </li>
                    }
                </ul>
            </nav>
            <div class="who">
                <a class="bell" href="/Notifications">@L["[[notification|plural]]"]@if (nav.Unread > 0) { <span class="badge warn"><span class="visually-hidden">@L["unread:"] </span>@nav.Unread</span> }</a>
                <span>@L["Signed in as"] <strong>@User.Identity!.Name</strong></span>
                <form method="post" asp-page="/SignOut"><button class="secondary" type="submit">@L["Sign out"]</button></form>
            </div>
        }
    </header>
    <main id="main" tabindex="-1">
        @if (crumb is { } here)
        {
            <nav class="breadcrumb" aria-label="@L["Breadcrumb"]">
                <ol>
                    <li><a href="/Admin">@L["Administration"]</a></li>
                    <li>@L[here.Section.Title]</li>
                    <li><span aria-current="page">@L[here.Item.Text]</span></li>
                </ol>
            </nav>
        }
        @if (TempData["Flash"] is string flash)
        {
            <div class="flash" role="status">@flash</div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">@productName@(string.IsNullOrWhiteSpace(branding.FooterText) ? "" : " · " + branding.FooterText) &middot; @L["Production approval is external governance; this build does not declare it."]</footer>
    <script src="~/js/nav.js" asp-append-version="true" defer></script>
</body>
</html>
