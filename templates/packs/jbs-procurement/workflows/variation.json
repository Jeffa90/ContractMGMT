   "from": [
    "Prepared"
   ],
   "to": "OutForSignature",
   "permission": "variations.create",
   "role": "sendSignature",
   "guards": [
    "FinalDocumentExists"
   ]
  },
  {
   "code": "SubmitApproval",
   "display": "Submit approval",
   "from": [
    "OutForSignature"
   ],
   "to": "AwaitingApproval",
   "permission": "variations.create",
   "role": "submitRegister",
   "guards": [
    "ExecutedCopyExists"
   ]
  },
  {
   "code": "ReturnToDrafting",
   "display": "Return to drafting",
   "from": [
    "OutForSignature"
   ],
   "to": "Prepared",
   "permission": "variations.create",
   "role": "returnToDrafting",
   "guards": [
    "SignatureVoidedOrDeclined"
   ]
  },
  {
   "code": "Approve",
   "display": "Approve and apply",
   "from": [
    "AwaitingApproval"
   ],
   "to": "Applied",
   "permission": "approvals.action",
   "role": "approve",
   "guards": [
    "ExecutedCopyExists",
    "AuthorisedApprover",
    "SubmitterNotApprover"
   ]
  },
  {
   "code": "Reject",
   "display": "Reject",
   "from": [
    "AwaitingApproval"
   ],
   "to": "Rejected",
   "permission": "approvals.action",
   "role": "reject",
   "guards": [
    "CommentRequired",
    "AuthorisedApprover",
    "SubmitterNotApprover"
   ],
   "commentRequired": true
  },
  {
   "code": "CancelDraft",
   "display": "Cancel",
   "from": [
    "Draft"
   ],
   "to": "Cancelled",
   "permission": "variations.create",
   "role": "cancel",
   "guards": [
    "ReasonRequired"
   ],
   "reasonRequired": true
  },
  {
   "code": "CancelLegalRework",
   "display": "Cancel",
   "from": [
