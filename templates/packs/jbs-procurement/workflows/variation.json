   "locked": false,
   "freezeContent": false,
   "documentPolicy": "Open",
   "terminal": true
  },
  {
   "code": "Rejected",
   "display": "Rejected",
   "role": "rejected",
   "locked": false,
   "freezeContent": false,
   "documentPolicy": "Open",
   "terminal": true
