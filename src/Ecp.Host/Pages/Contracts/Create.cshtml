@page "/Contracts/Create"
@model Ecp.Host.Pages.Contracts.CreateModel
@{ ViewData["Title"] = L["Create [[contract|lower|a]]"].Value; }
<h1>@L["Create [[contract|lower|a]]"]</h1>

@if (Model.Organisations.Count == 0)
{
    <p class="flash warn" role="status">@L["You do not hold a role that can create [[contract|plural|lower]]."]</p>
}
else if (Model.OrganisationId is null)
{
    <form method="get">
        <p class="lede">@L["Choose the [[organisation|lower]] the [[contract|lower]] belongs to. [[organisation]] is a mandatory policy and reporting scope."]</p>
        <div class="field">
            <label for="orgId">@L["[[organisation]]"]</label>
            <select id="orgId" name="organisationId" required aria-required="true">
                @foreach (var o in Model.Organisations) { <option value="@o.Id">@o.Name</option> }
            </select>
        </div>
        <button type="submit">@L["Continue"]</button>
    </form>
}
else
{
    <partial name="_Errors" model="ViewData.ModelState" />
    <p class="lede">@L["[[organisation]]"]: <strong>@Model.OrganisationName</strong>. @L["The [[contract.reference|lower]] is assigned automatically using this [[organisation|lower]]'s prefix:"] <code>@Model.NextReference</code></p>
    <form method="post">
        <input type="hidden" name="OrganisationId" value="@Model.OrganisationId" />
        <div class="field"><label for="Title">@L["Title"]</label><input id="Title" name="Title" type="text" required aria-required="true" maxlength="500" value="@Model.Title" /></div>
        <div class="field">
            <label for="SupplierId">@L["[[supplier]]"]</label>
            <select id="SupplierId" name="SupplierId" required aria-required="true">
                <option value="">@L["Choose [[supplier|lower|a]]"]</option>
                @foreach (var s in Model.Suppliers) { <option value="@s.Id" selected="@(s.Id == Model.SupplierId)">@s.Name</option> }
            </select>
            <p class="hint"><a href="/Suppliers/Create?organisationId=@Model.OrganisationId">@L["Add [[supplier|lower|a]]"]</a></p>
        </div>
        <div class="field">
            <label for="CategoryId">@L["[[category]]"]</label>
            <select id="CategoryId" name="CategoryId" required aria-required="true">
                <option value="">@L["Choose [[category|lower|a]]"]</option>
                @foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option> }
            </select>
        </div>
        <div class="field">
            <label for="Classification">@L["Classification"]</label>
            <select id="Classification" name="Classification">
                @foreach (var level in Model.Levels) { <option value="@level" selected="@(level == Model.Classification)">@level</option> }
            </select>
        </div>
        <partial name="_ContractFields" model="new ContractFieldsView(Model.Input, Model.Options)" />
        <div class="field"><label for="Description">@L["Description"]</label><textarea id="Description" name="Description" maxlength="4000">@Model.Description</textarea></div>
        @if (Model.Fields is { } fields && fields.Fields.Count > 0)
        {
            <h2>@L["Additional details"]</h2>
            <p class="hint">@L["These fields are set up by your administrators. Fields that depend on the [[contract.type|lower]] appear for the type you choose; use the button below after changing it."]</p>
            <partial name="_CustomFieldInputs" model="fields" />
            <button type="submit" class="secondary" asp-page-handler="Refresh" formnovalidate>@L["Show the fields for this [[contract.type|lower]]"]</button>
        }
        <div class="actions"><button type="submit">@L["Create draft"]</button> <a class="button secondary" href="/Contracts">@L["Cancel"]</a></div>
    </form>
}
