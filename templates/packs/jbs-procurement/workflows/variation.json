   ],
   "to": "InLegalReview",
   "permission": "legal.review",
   "role": "beginLegal"
  },
  {
   "code": "ReturnForRework",
   "display": "Return for rework",
   "from": [
    "InLegalReview"
   ],
   "to": "LegalReworkRequired",
   "permission": "legal.review",
   "role": "returnLegal",
   "guards": [
    "CommentRequired"
   ],
   "commentRequired": true
  },
  {
   "code": "ClearLegal",
