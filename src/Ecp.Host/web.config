<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for Ecp.Host (ASP.NET Core Module V2, in-process). `dotnet publish` keeps this file and stamps processPath/arguments into it.
  Settings are NOT placed here: the deploy script writes only non-secret APPENV_ values as environment variables; secrets stay in the secret store
  and are referenced (file:/env:). Request-size limits below must stay consistent with src/Ecp.Host/UploadLimits.cs (a test checks this).
  Request timeout: in-process hosting has no ANCM request timeout (requestTimeout is out-of-process only); the application applies its own
  per-endpoint policy (UploadLimits, Ecp:Http:*TimeoutSeconds). Verification status: see docs/JBS_IIS_IMPLEMENTATION_STATUS.md.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Ecp.Host.dll" hostingModel="inprocess" stdoutLogEnabled="false" startupTimeLimit="120" shutdownTimeLimit="30" />
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- Default for every URL: 10 MiB. Only the upload URLs below are raised. -->
          <requestLimits maxAllowedContentLength="10485760" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- Contract, variation, legal-review and executed-copy documents: 100 MiB document limit + 1 MiB multipart envelope. -->
  <location path="Contracts/Documents">
    <system.webServer><security><requestFiltering><requestLimits maxAllowedContentLength="105906176" /></requestFiltering></security></system.webServer>
  </location>
  <location path="Contracts/Lifecycle">
    <system.webServer><security><requestFiltering><requestLimits maxAllowedContentLength="105906176" /></requestFiltering></security></system.webServer>
  </location>
  <location path="Variations/Details">
    <system.webServer><security><requestFiltering><requestLimits maxAllowedContentLength="105906176" /></requestFiltering></security></system.webServer>
  </location>
  <location path="Legal/Review">
    <system.webServer><security><requestFiltering><requestLimits maxAllowedContentLength="105906176" /></requestFiltering></security></system.webServer>
  </location>

  <!-- Bulk-migration archive upload: the only URL opened to 2 GiB. -->
  <location path="Migration/Batches">
    <system.webServer><security><requestFiltering><requestLimits maxAllowedContentLength="2147483648" /></requestFiltering></security></system.webServer>
  </location>
</configuration>
