{
 "schemaVersion": 1,
 "workflow": "variation",
 "subject": "Variation",
 "description": "Reference Variation workflow of the JBS Procurement pack. Its outcome (Applied, Rejected or Cancelled) returns the parent agreement to its prior state.",
 "settings": {
  "documents": {
   "executedCopyType": "ExecutedContract",
   "finalTypes": [
    "VariationDocument"
   ],
   "legalMarkupType": "LegalMarkup",
   "approvalEvidenceType": "ApprovalEvidence"
  },
  "approval": {
   "approverGroupKey": "GroupHeadProcurement",
   "requireExecutedCopy": true
  },
  "legal": {
   "reworkReasonRequired": true
  },
  "variation": {
   "legalReview": "Optional",
   "changeableFields": [
    "currencyCode",
    "estimatedValue",
    "extensionType",
    "noticePeriodDays",
    "criticalNotice",
    "reviewDate",
    "endDate",
    "businessUnitId",
    "siteId"
   ]
  }
 },
 "states": [
  {
   "code": "Draft",
