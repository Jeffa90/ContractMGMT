{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Ecp": {
    "Mode": "Demo",
    "DemoTenantResolution": true,
    "DemoSeed": true,
    "DemoTenantName": "Demo Tenant",
    "DataDirectory": "data",
    "Localisation": {
      "DefaultCulture": "en-AU",
      "DefaultTimeZoneId": "Australia/Brisbane",
      "DefaultCurrencyCode": "AUD",
      "SupportedCultures": [ "en-AU", "en-US" ]
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/ecp-demo.db",
    "ConnectionStringRef": "",
    "AutoMigrate": true
  },
  "Contracts": { "InitialStatusCode": "Draft" },
  "Documents": { "MaxFileBytes": 104857600, "AllowSkippedScan": false }
}
