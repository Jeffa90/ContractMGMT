@page "/Admin/Users/Details/{id:guid}"
@model Ecp.Host.Pages.Admin.Users.DetailsModel
@{ ViewData["Title"] = Model.Person.DisplayName; }
<h1>@Model.Person.DisplayName</h1>
<p><span class="badge">@Model.Person.Email</span> <span class="badge @(Model.Person.Status == Ecp.Identity.Domain.UserStatus.Disabled ? "bad" : "ok")">@Model.Person.Status</span></p>
<partial name="_Errors" model="ViewData.ModelState" />

<h2>@L["Role assignments"]</h2>
<div class="table-wrap">
<table>
    <caption class="visually-hidden">@L["Role assignments"]</caption>
    <thead><tr><th scope="col">@L["Role"]</th><th scope="col">@L["Scope"]</th><th scope="col">@L["Ceiling"]</th><th scope="col">@L["Effective"]</th><th scope="col">@L["Granted by"]</th><th scope="col">@L["Actions"]</th></tr></thead>
    <tbody>
    @foreach (var a in Model.Assignments)
    {
        <tr>
            <th scope="row">@Terms.Role(a.RoleCode) <code class="id" title="@L["Stable role identifier"]">@a.RoleCode</code>@if (a.ViewerKind is { } k) { <text> (@k)</text> }@if (a.ApproverGroupKey is { } g) { <br /><span class="hint">@L["Approver group"]: @Terms.GroupLabel(g)</span> }</th>
            <td>@Terms.Expand(Model.Describe(a))</td><td>@a.Scope.ClassificationCeiling</td>
            <td>@Model.Period(a)</td><td>@a.GrantedByLabel (@a.Source)</td>
            <td>
                @if (a.IsActive)
                {
                    <form method="post" asp-page-handler="Revoke">
                        <input type="hidden" name="assignmentId" value="@a.Id" />
                        <label for="reason-@a.Id" class="visually-hidden">@L["Reason for ending"] @Terms.Role(a.RoleCode)</label>
                        <input id="reason-@a.Id" name="reason" type="text" required aria-required="true" placeholder="@L["Reason"]" maxlength="1000" />
                        <button class="secondary" type="submit">@L["End assignment"]</button>
                    </form>
                }
                else { <span class="badge">@L["Ended"]</span> }
            </td>
        </tr>
    }
    @if (Model.Assignments.Count == 0) { <tr><td colspan="6">@L["No role assignments."]</td></tr> }
    </tbody>
</table>
</div>

<h2>@L["Grant a role"]</h2>
@if (Model.GrantableRoles.Count == 0)
{
    <p class="flash warn" role="status">@L["Your role does not allow you to grant roles."]</p>
}
else
{
<form method="post" asp-page-handler="Grant">
    <div class="field"><label for="role">@L["Role"]</label>
        <select id="role" name="role" required aria-required="true" aria-describedby="role-hint">@foreach (var r in Model.GrantableRoles) { <option value="@r">@Terms.Role(r) (@r)</option> }</select>
        @if (Model.RolesNotOffered.Count > 0) { <p id="role-hint" class="hint">@L["Not offered here: {0}. Their holders are still listed above and keep their access.", string.Join(", ", Model.RolesNotOffered.Select(Terms.Role))]</p> }</div>
    <div class="field"><label for="viewerKind">@L["Viewer kind (Viewer role only)"]</label>
        <select id="viewerKind" name="viewerKind" aria-describedby="vk-hint"><option value="">@L["Not a viewer"]</option>@foreach (var k in Enum.GetValues<Ecp.Identity.Domain.ViewerKind>()) { <option value="@k">@k</option> }</select>
        <p id="vk-hint" class="hint">@L["A Viewer is never a global read role: choose All [[contract|plural]], [[category]], [[business.unit]], [[site]] or Restricted, with the matching scope below."]</p></div>
    <div class="field"><label for="level">@L["Applies to"]</label>
        <select id="level" name="level"><option value="Organisation">@L["Selected [[organisation|plural|lower]]"]</option><option value="Tenant">@L["Whole tenant (Tenant Administrator and tenant-wide Auditor)"]</option><option value="Installation">@L["Installation (System Administrator)"]</option></select></div>
    <div class="field"><label for="organisations">@L["[[organisation|plural]]"]</label>
        <select id="organisations" name="organisations" multiple size="4">@foreach (var o in Model.Organisations) { <option value="@o.Id">@o.Name</option> }</select></div>
    <div class="field"><label for="divisions">@L["[[division|plural]] (narrowing)"]</label>
        <select id="divisions" name="divisions" multiple size="3">@foreach (var d in Model.Divisions) { <option value="@d.Id">@d.Name</option> }</select></div>
    <div class="field"><label for="businessUnits">@L["[[business.unit|plural|sentence]] (narrowing)"]</label>
        <select id="businessUnits" name="businessUnits" multiple size="3">@foreach (var b in Model.BusinessUnits) { <option value="@b.Id">@b.Name</option> }</select></div>
    <div class="field"><label for="sites">@L["[[site|plural]] (narrowing)"]</label>
        <select id="sites" name="sites" multiple size="3">@foreach (var s in Model.Sites) { <option value="@s.Id">@s.Name</option> }</select></div>
    <div class="field"><label for="categories">@L["[[category|plural]] (narrowing; a parent covers its [[subcategory|plural|lower]])"]</label>
        <select id="categories" name="categories" multiple size="4">@foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }</select></div>
    <div class="field"><label for="ceiling">@L["Classification ceiling"]</label>
        <select id="ceiling" name="ceiling">@foreach (var l in Model.Levels) { <option value="@l" selected="@(l == Model.DefaultLevel)">@l</option> }</select></div>
    <div class="field"><label for="approverGroup">@L["Approver group (Approver and Backup Approver only)"]</label><input id="approverGroup" name="approverGroup" type="text" maxlength="100" /></div>
    <div class="field"><label for="reason">@L["Reason"]</label><input id="reason" name="reason" type="text" required aria-required="true" maxlength="1000" /></div>
    <button type="submit">@L["Grant role"]</button>
</form>
}

<h2>@L["Account"]</h2>
<form method="post" asp-page-handler="@(Model.Person.Status == Ecp.Identity.Domain.UserStatus.Disabled ? "Reactivate" : "Disable")">
    @if (Model.Person.Status != Ecp.Identity.Domain.UserStatus.Disabled)
    {
        <div class="field"><label for="disable-reason">@L["Reason for disabling"]</label><input id="disable-reason" name="reason" type="text" required aria-required="true" maxlength="1000" /></div>
        <button class="danger" type="submit">@L["Disable account"]</button>
    }
    else { <button type="submit">@L["Reactivate account"]</button> }
</form>
<p><a href="/Admin/Users">@L["Back to people"]</a></p>
