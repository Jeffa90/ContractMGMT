@page "/Admin/Packs"
@model Ecp.Host.Pages.Admin.Packs.IndexModel
@{ ViewData["Title"] = L["[[solution.pack|plural|sentence]]"].Value; }
<h1>@L["[[solution.pack|plural|sentence]]"]</h1>
<p class="lede">@L["[[solution.pack|lower|a|cap]] is a ready-made starting point for a business: its [[contract|lower]] lifecycle, [[variation]] workflow and [[notification|lower]] policy. Packs are data only. They never run code. Installing a pack makes it available; it changes nothing until you assign it to [[organisation|lower|a]], and even then it only prepares drafts for you to review and publish."]</p>
<nav class="actions" aria-label="@L["Pack Manager"]">
    <a class="button" href="/Admin/Packs/Upload">@L["Upload a pack"]</a>
    <a class="button secondary" href="/Admin/Packs/Assign">@L["[[organisation]] packs"]</a>
    <a class="button secondary" href="/Admin/Packs/TrustKeys">@L["Trusted publishers"]</a>
    <a class="button secondary" href="/Admin/Packs/Audit">@L["History"]</a>
    <a class="button secondary" href="/Admin/Packs/Checks">@L["Checks"]</a>
</nav>
<details class="card"><summary>@L["Who does what when a pack comes to this installation"]</summary>
    <ol>
        <li><strong>@L["The publisher"]</strong> @L["(a Pack Publisher, outside this application) builds the pack with the pack tool and signs it with a private key. The key is held in the publisher's own key store and never reaches this application or its administrators."]</li>
        <li><strong>@L["A system administrator"]</strong> @L["decides which publisher keys the installation trusts and registers only the public key, under Trusted publishers. Production accepts nothing signed by any other key."]</li>
        <li><strong>@L["A business administrator"]</strong> @L["uploads the signed file, reads the checks, installs it, and assigns it to an organisation. The pack prepares drafts; a second person publishes them."]</li>
        <li><strong>@L["Key custody"]</strong> @L["(your security team, or the publisher) keeps the private key, rotates it and revokes it. A revoked key stops its packs being accepted for new installs."]</li>
    </ol>
    <p class="hint">@L["This page never asks for a private key and the application cannot sign a pack. If you are asked to paste one anywhere, stop and tell your security team."]</p>
</details>
<p>
    @L["Show"]:
    <a href="/Admin/Packs" aria-current="@(Model.Show == "all" ? "page" : null)">@L["All packs"]</a> |
    <a href="/Admin/Packs?show=shipped" aria-current="@(Model.Show == "shipped" ? "page" : null)">@L["Shipped with this installation"]</a> |
    <a href="/Admin/Packs?show=installed" aria-current="@(Model.Show == "installed" ? "page" : null)">@L["Installed by administrators"]</a>
</p>
<div class="table-wrap">
<table>
    <caption class="visually-hidden">@L["[[solution.pack|plural|sentence]]"]</caption>
    <thead><tr>
        <th scope="col">@L["Pack"]</th><th scope="col">@L["Version"]</th><th scope="col">@L["Publisher"]</th><th scope="col">@L["Source"]</th><th scope="col">@L["Signature"]</th>
        <th scope="col">@L["Compatible"]</th><th scope="col">@L["Status"]</th><th scope="col">@L["[[organisation|plural]] using it"]</th><th scope="col">@L["Installed (UTC)"]</th><th scope="col"><span class="visually-hidden">@L["Details"]</span></th>
    </tr></thead>
    <tbody>
    @foreach (var i in Model.Items)
    {
        var e = i.Entry;
        <tr>
            <td>@e.Name()<br /><span class="hint">@e.PackKey</span></td>
            <td>@e.Version</td>
            <td>@e.PublisherName</td>
            <td>@(e.IsShipped ? L["Shipped"] : L["Installed"])</td>
            <td>
                @if (e.Trust.IsTrusted) { <span class="badge ok">@L["Signed, trusted"]</span> }
                else if (e.Trust.Status == Ecp.Packs.TrustStatus.UnsignedSyntheticAllowed) { <span class="badge warn">@L["NOT SIGNED (demonstration or test only)"]</span> }
                else { <span class="badge bad">@L["Not trusted"]</span> }
            </td>
            <td>@(e.IsCompatible ? L["Yes"] : L["No"])</td>
            <td>
                @if (e.Unavailable) { <span class="badge bad">@L["Unavailable"]</span> }
                else if (e.Retired) { <span class="badge">@L["Retired"]</span> }
                else if (e.IsUsable) { <span class="badge ok">@L["Ready to use"]</span> }
                else { <span class="badge bad">@L["Cannot be used here"]</span> }
            </td>
            <td>@i.OrganisationsUsing</td>
            <td>@Fmt.DateTime(e.InstalledUtc)</td>
            <td><a href="/Admin/Packs/Details?key=@Uri.EscapeDataString(e.PackKey)&amp;version=@Uri.EscapeDataString(e.Version)">@L["Details"]<span class="visually-hidden"> @e.PackKey @e.Version</span></a></td>
        </tr>
    }
    @if (Model.Items.Count == 0) { <tr><td colspan="10">@L["No [[solution.pack|plural|lower]] are available. Upload one, or continue with the Blank configuration."]</td></tr> }
    </tbody>
</table>
</div>
<details class="card"><summary>@L["Help: what do these columns mean?"]</summary>
    <p><strong>@L["Signature"]</strong>: @L["A publisher signs a pack so you can tell it has not been altered and who made it. Production only accepts packs signed by a publisher you trust."]</p>
    <p><strong>@L["Compatible"]</strong>: @L["Whether this version of the platform can use the pack."]</p>
    <p><strong>@L["Retired"]</strong>: @L["A retired pack cannot be given to more [[organisation|plural|lower]]. [[organisation|plural]] already using it are not changed."]</p>
</details>
