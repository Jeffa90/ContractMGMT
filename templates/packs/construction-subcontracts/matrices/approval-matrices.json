          },
          "steps": [
            {
              "key": "project-director",
              "display": "Project Director",
              "approverGroup": "ProjectDirectors",
              "mode": "FirstResponse",
              "backupGroup": "ProjectDirectorDeputies"
            },
            {
              "key": "commercial-manager",
              "display": "Commercial Manager",
              "approverGroup": "CommercialManagers",
              "mode": "FirstResponse",
              "backupGroup": "CommercialManagerDeputies"
            }
          ]
        },
        {
          "code": "co-large",
          "description": "5000000 and above: Project Director, Commercial Manager and Regional Director in parallel, all required",
          "kind": "Base",
          "priority": 100,
          "flow": "Parallel",
          "when": {
            "valueMin": 5000000.0
          },
          "steps": [
            {
              "key": "project-director",
              "display": "Project Director",
              "approverGroup": "ProjectDirectors",
              "mode": "AllRequired",
              "backupGroup": "ProjectDirectorDeputies"
            },
            {
              "key": "commercial-manager",
              "display": "Commercial Manager",
              "approverGroup": "CommercialManagers",
              "mode": "AllRequired",
              "backupGroup": "CommercialManagerDeputies"
            },
            {
              "key": "regional-director",
              "display": "Regional Director",
              "approverGroup": "RegionalDirectors",
              "mode": "AllRequired"
            }
          ]
        },
        {
          "code": "co-high-risk",
          "description": "High or critical risk adds a Safety and Risk step after the base steps",
          "kind": "Exception",
          "effect": "AddSteps",
          "priority": 200,
          "when": {
            "riskLevels": [
              "High",
              "Critical"
            ]
          },
          "steps": [
            {
              "key": "safety-risk",
              "display": "Safety and Risk Manager",
              "approverGroup": "SafetyRisk",
              "mode": "FirstResponse"
            }
          ]
        },
        {
          "code": "co-administrative",
          "description": "An administrative change order records a fact and changes no value",
          "kind": "Base",
          "priority": 300,
          "flow": "Sequential",
          "when": {
            "custom": [
              {
                "field": "change_order_type",
                "operator": "Equals",
                "values": [
                  "ADMINISTRATIVE"
                ]
              }
            ]
          },
          "steps": [
            {
              "key": "commercial-manager",
              "display": "Commercial Manager",
              "approverGroup": "CommercialManagers",
              "mode": "FirstResponse",
              "backupGroup": "CommercialManagerDeputies"
            }
          ]
        }
      ]
    }
  ]
}
