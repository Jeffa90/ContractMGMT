   ],
   "to": "Cancelled",
   "permission": "variations.create",
   "role": "cancel",
   "guards": [
    "ReasonRequired"
   ],
   "reasonRequired": true
  },
  {
   "code": "CancelPrepared",
   "display": "Cancel",
   "from": [
    "Prepared"
   ],
   "to": "Cancelled",
   "permission": "variations.create",
   "role": "cancel",
   "guards": [
    "ReasonRequired"
   ],
   "reasonRequired": true
  },
  {
   "code": "CancelLegalCleared",
   "display": "Cancel",
   "from": [
    "LegalCleared"
   ],
   "to": "Cancelled",
   "permission": "variations.create",
   "role": "cancel",
   "guards": [
    "ReasonRequired"
   ],
   "reasonRequired": true
  },
  {
   "code": "CancelSignature",
   "display": "Cancel",
   "from": [
    "OutForSignature"
   ],
   "to": "Cancelled",
   "permission": "variations.create",
   "role": "cancel",
   "guards": [
    "ReasonRequired"
   ],
   "reasonRequired": true
  }
 ]
