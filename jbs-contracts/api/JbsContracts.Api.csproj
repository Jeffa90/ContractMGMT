<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>JbsContracts.Api</RootNamespace>
    <AssemblyName>JbsContracts.Api</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>
  <ItemGroup>
    <!-- The numbered SQL scripts ship with the app so local runs and tests apply exactly what the deploy applies. -->
    <Content Include="../database/*.sql" LinkBase="database" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JbsContracts.Api.Tests" />
  </ItemGroup>
</Project>
