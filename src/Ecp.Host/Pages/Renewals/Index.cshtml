@page "/Renewals"
@model Ecp.Host.Pages.Renewals.IndexModel
@{ ViewData["Title"] = L["[[renewal|plural]] in progress"].Value; }
<h1>@L["[[renewal|plural]] in progress"]</h1>
<p class="lede">@L["[[agreement|plural]] being renewed. Each [[renewal|lower]] has a successor draft linked to the [[agreement|lower]] it replaces; the [[agreement|lower]] being renewed is not changed by the [[renewal|lower]]."]</p>
<p role="status">@Model.Result.Total @L["[[renewal|lower]](s) in progress"]</p>
<div class="table-wrap">
<table>
    <caption class="visually-hidden">@L["[[renewal|plural]] in progress"]</caption>
    <thead><tr><th scope="col">@L["[[agreement]] being renewed"]</th><th scope="col">@L["[[supplier]]"]</th><th scope="col">@L["Successor"]</th><th scope="col">@L["Started"]</th><th scope="col">@L["By"]</th><th scope="col">@L["Copied"]</th></tr></thead>
    <tbody>
    @foreach (var r in Model.Result.Items)
    {
        <tr><th scope="row"><a href="/Contracts/Lifecycle/@r.PredecessorContractId">@r.PredecessorReference</a> <span class="hint">@r.PredecessorTitle</span></th><td>@r.SupplierName</td>
            <td>@if (r.SuccessorReference is { } sr) { <a href="/Contracts/Details/@r.SuccessorContractId">@sr</a> <span class="hint">(@r.SuccessorStatus)</span> } else { <span class="hint">@L["not visible to you"]</span> }</td>
            <td>@r.StartedUtc.ToString("yyyy-MM-dd")</td><td>@r.StartedBy</td><td>@r.CopiedFields.Count @L["field(s)"], @r.CopiedDocuments.Count @L["[[document|lower]](s)"]</td></tr>
    }
    @if (Model.Result.Items.Count == 0) { <tr><td colspan="6">@L["No [[renewal|lower]] is in progress."]</td></tr> }
    </tbody>
</table>
</div>
