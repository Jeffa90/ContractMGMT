@page "/SignIn"
@model SignInModel
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{ ViewData["Title"] = L["Sign in"].Value; }
<h1>@L["Sign in"]</h1>

@if (Model.Message is not null)
{
    <div class="error-summary" role="alert" tabindex="-1" id="signin-error"><h2>@L["Sign-in was not completed"]</h2><p>@Model.Message</p></div>
}

@if (Model.Providers.Count > 0)
{
    <section aria-labelledby="idp-h" class="card">
        <h2 id="idp-h">@L["[[organisation]] sign-in"]</h2>
        <ul>
            @foreach (var p in Model.Providers)
            {
                <li><a class="button" href="/Account/Challenge?scheme=@Uri.EscapeDataString(p.Scheme)&amp;returnUrl=@Uri.EscapeDataString(Model.ReturnUrl)">@L["Sign in with"] @p.Settings.DisplayName</a></li>
            }
        </ul>
    </section>
}

@if (Model.DemoEnabled)
{
    <section aria-labelledby="demo-h" class="card">
        <h2 id="demo-h">@L["Demonstration identity"]</h2>
        <p class="lede">@L["Demonstration sign-in is available only in Demo and Test modes. Choose a synthetic user; no password is used. Production refuses this provider."]</p>
        @if (!Model.DemoAllowedHere)
        {
            <p class="error" role="alert">@L["Demonstration sign-in is limited to this computer. Set Identity:Demo:AllowRemote to allow other addresses (Demo only)."]</p>
        }
        else
        {
            <form method="post">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <div class="table-wrap">
                    <table>
                        <caption>@L["Synthetic users"]</caption>
                        <thead><tr><th scope="col">@L["Choose"]</th><th scope="col">@L["User"]</th><th scope="col">@L["Tenant"]</th><th scope="col">@L["Roles"]</th></tr></thead>
                        <tbody>
                        @foreach (var u in Model.DemoUsers)
                        {
                            <tr>
                                <td><button type="submit" name="pick" value="@u.TenantId:@u.UserId" aria-label="@L["Sign in as"] @u.DisplayName">@L["Sign in"]</button></td>
                                <td>@u.DisplayName<br /><span class="hint">@u.Email</span></td>
                                <td>@u.TenantName</td>
                                <td>@u.Roles</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </form>
        }
    </section>
}
else if (Model.Providers.Count == 0)
{
    <p class="card">@L["No sign-in provider is available. Contact your administrator."]</p>
}
