@page "/Migration/Batches/{id:guid}/Files"
@model Ecp.Host.Pages.Migration.FilesModel
@using Ecp.DataMigration.Domain
@{ ViewData["Title"] = L["Attachments"].Value; }
<p><a href="/Migration/Batches/@Model.BatchId#review">&larr; @L["Back to the [[migration.batch|lower]]"]</a></p>
<h1>@L["Attachments and the unmatched queue"]</h1>
<p class="lede">@L["Each file is matched to [[contract|lower|a]] in a fixed order: the manifest's SourceRecordId, the manifest's AgreementReference, the profile's naming rule, then the exact folder name. The reason for each match is shown. If more than one [[contract|lower]] fits, or none does, the file waits here for a person: the platform never guesses. Files in the queue are never lost; discarding one is recorded."]</p>
<partial name="_Errors" model="ViewData.ModelState" />
<form method="get" class="card">
    <div class="field"><label for="state">@L["State"]</label>
        <select id="state" name="state"><option value="">@L["All"]</option>@foreach (var s in Enum.GetValues<FileState>()) { <option value="@s" selected="@(Model.State == s)">@s</option> }</select></div>
    <div class="check field"><input id="queueOnly" name="queueOnly" type="checkbox" value="true" checked="@Model.QueueOnly" /><label for="queueOnly">@L["Only files waiting for a person (the queue)"]</label></div>
    <div class="actions"><button type="submit">@L["Filter"]</button></div>
</form>
<p role="status">@Model.Result.Total @L["file(s)"]</p>
@foreach (var f in Model.Result.Items)
{
    <article class="card" aria-labelledby="f-@f.Id">
        <h3 id="f-@f.Id">@f.RelativePath</h3>
        <p><span class="badge @(f.State is FileState.Imported or FileState.Matched ? "ok" : f.State is FileState.Invalid or FileState.Failed ? "bad" : f.State == FileState.Unmatched ? "warn" : "")">@f.State@(f.QueueReason != QueueReason.None ? " (" + f.QueueReason + ")" : "")</span>
           <span class="hint">@(f.DocumentType ?? L["no manifest row"].Value) · @f.SizeBytes @L["bytes"] · @L["scan"]: @f.Scan@(f.Sha256 is null ? "" : " · SHA-256 " + f.Sha256[..12] + "…")</span></p>
        @if (f.MatchedBy is { } method) { <p>@L["Matched by"] <strong>@method</strong>@(f.ContractReference is null ? "" : " to " + f.ContractReference)@(f.ResolvedBy is null ? "" : " (" + f.ResolvedBy + ")")</p> }
        @if (f.Note is { Length: > 0 }) { <p class="hint">@f.Note</p> }
        @if (f.Proposals.Count > 0)
        {
            <p>@L["Why:"]</p>
            <ul>@foreach (var p in f.Proposals) { <li>@p.Method: @p.Reason <span class="badge">@p.Status</span></li> }</ul>
        }
        @if (Model.Can.CanStage && f.State is FileState.Unmatched or FileState.Matched or FileState.Staged)
        {
            <form method="post" asp-page-handler="Match" class="actions">
                <input type="hidden" name="FileId" value="@f.Id" />
                <label for="c-@f.Id" class="visually-hidden">@L["[[contract]] for"] @f.RelativePath</label>
                <select id="c-@f.Id" name="ContractRowId">@foreach (var c in Model.Choices) { <option value="@c.RowId" selected="@(f.Proposals.Count == 1 && f.Proposals[0].ContractRowId == c.RowId)">@(c.AgreementReference ?? c.SourceRecordId) (@L["row"] @c.Sequence)</option> }</select>
                <button type="submit" class="secondary">@L["Match to this [[contract|lower]]"]</button>
            </form>
            @if (f.State == FileState.Unmatched && f.QueueReason == QueueReason.DuplicateReview)
            {
                <form method="post" asp-page-handler="Release"><input type="hidden" name="FileId" value="@f.Id" /><button type="submit" class="secondary">@L["Import it as a separate [[document|lower]]"]</button></form>
            }
            <form method="post" asp-page-handler="Discard" class="actions">
                <input type="hidden" name="FileId" value="@f.Id" />
                <label for="r-@f.Id" class="visually-hidden">@L["Reason for discarding"] @f.RelativePath</label>
                <input id="r-@f.Id" name="Reason" type="text" maxlength="1000" placeholder="@L["Reason for discarding (recorded)"]" required />
                <button type="submit" class="danger">@L["Discard"]</button>
            </form>
        }
    </article>
}
@if (Model.Result.Items.Count == 0) { <p>@L["No files."]</p> }
@if (Model.Result.PageCount > 1)
{
    <nav class="pager" aria-label="@L["Pages"]">
        @if (Model.Result.Page > 1) { <a href="@Model.PageLink(Model.Result.Page - 1)">@L["Previous"]</a> }
        <span>@L["Page"] @Model.Result.Page @L["of"] @Model.Result.PageCount</span>
        @if (Model.Result.Page < Model.Result.PageCount) { <a href="@Model.PageLink(Model.Result.Page + 1)">@L["Next"]</a> }
    </nav>
}

<h2>@L["Attachment manifest"]</h2>
<div class="table-wrap"><table>
    <caption class="visually-hidden">@L["Manifest rows"]</caption>
    <thead><tr><th scope="col">@L["Row"]</th><th scope="col">@L["Source record"]</th><th scope="col">@L["[[contract.reference|sentence]]"]</th><th scope="col">@L["Path"]</th><th scope="col">@L["[[document]] type"]</th><th scope="col">@L["State"]</th></tr></thead>
    <tbody>
    @foreach (var m in Model.Manifest) { <tr><th scope="row">@m.RowNumber</th><td>@m.SourceRecordId</td><td>@m.AgreementReference</td><td>@m.RelativePath</td><td>@(m.DocumentTypeCode ?? m.DocumentTypeRaw)</td><td>@m.State</td></tr> }
    @if (Model.Manifest.Count == 0) { <tr><td colspan="6">@L["No manifest loaded."]</td></tr> }
    </tbody>
</table></div>
