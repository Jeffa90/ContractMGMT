@page "/Admin/Operations/UpgradeReadiness"
@model Ecp.Host.Pages.Admin.Operations.UpgradeReadinessModel
@{ ViewData["Title"] = L["Upgrade readiness"].Value; var r = Model.Report; }
<h1>@L["Upgrade readiness"]</h1>
<p class="lede">@L["The pre-flight says whether this installation can be upgraded safely to the version now running, and why not if it cannot. It reads and changes nothing. A blocker stops the upgrade; a warning needs the owner's explicit acceptance. Passing the pre-flight is not an approval to upgrade or to go live."]</p>
<partial name="_Errors" model="ViewData.ModelState" />
<section class="card" aria-labelledby="run-h">
    <h2 id="run-h">@L["Run the pre-flight"]</h2>
    <form method="post" asp-page-handler="Run">
        <div class="field"><label for="BackupId">@L["Verified backup to roll back to"]</label>
            <select id="BackupId" name="BackupId"><option value="">@L["(the most recent verified backup)"]</option>
                @foreach (var b in Model.Backups) { <option value="@b.BackupId" selected="@(Model.BackupId == b.BackupId)">@b.BackupId</option> }
            </select></div>
        <div class="actions"><button type="submit">@L["Run the pre-flight"]</button> <span>@L["This reads every document and many tables; run it when the installation is quiet."]</span></div>
    </form>
</section>
@if (r is not null)
{
    <section class="card" role="status" aria-labelledby="out-h">
        <h2 id="out-h">@L["Outcome"]: <span class="badge @(r.Outcome == Ecp.Recovery.PreflightOutcome.Ready ? "ok" : r.Outcome == Ecp.Recovery.PreflightOutcome.ReadyWithWarnings ? "warn" : "bad")">@(r.Outcome switch { Ecp.Recovery.PreflightOutcome.Ready => "Ready", Ecp.Recovery.PreflightOutcome.ReadyWithWarnings => "Ready with warnings", Ecp.Recovery.PreflightOutcome.Blocked => "Blocked", _ => "Not Verified" })</span></h2>
        <dl class="facts">
            <dt>@L["Installation is at"]</dt><dd>@r.SourceVersion (@r.State)</dd>
            <dt>@L["Version to upgrade to"]</dt><dd>@r.TargetVersion</dd>
            <dt>@L["Upgrade manifest SHA-256"]</dt><dd><code>@(r.ManifestSha256 ?? "none")</code></dd>
            <dt>@L["Migrations pending"]</dt><dd>@r.PendingMigrations.Count</dd>
            <dt>@L["Correlation id"]</dt><dd><code>@r.CorrelationId</code></dd>
            @if (Model.Judgement is { } j)
            {
                <dt>@L["Counts as evidence"]</dt><dd><span class="badge @(j.Verdict == Ecp.Recovery.EvidenceVerdict.Passed ? "ok" : j.Verdict == Ecp.Recovery.EvidenceVerdict.Warning ? "warn" : j.Verdict == Ecp.Recovery.EvidenceVerdict.NotVerified ? "warn" : "bad")">@Ecp.Recovery.EvidenceSemantics.Label(j.Verdict)</span> <code>@j.Code</code> @j.Reason</dd>
            }
        </dl>
        <p>@r.Count(Ecp.Recovery.CheckOutcome.Passed) @L["passed"], @r.Count(Ecp.Recovery.CheckOutcome.Warning) @L["warnings"], @r.Count(Ecp.Recovery.CheckOutcome.Failed) @L["blockers"], @r.Count(Ecp.Recovery.CheckOutcome.NotVerified) @L["not verified"].</p>
        <ul>
            <li><a href="/Admin/Operations/UpgradeReadiness?handler=Json&amp;BackupId=@r.BackupId">@L["Download this report (JSON)"]</a></li>
            <li><a href="/Admin/Operations/UpgradeReadiness?handler=Csv&amp;BackupId=@r.BackupId">@L["Download this report (CSV, safe to open in a spreadsheet)"]</a></li>
            <li><a href="/Admin/Operations/UpgradePreview?BackupId=@r.BackupId">@L["Preview the upgrade"]</a></li>
        </ul>
    </section>
    <div class="table-wrap">
    <table>
        <caption class="visually-hidden">@L["Pre-flight findings"]</caption>
        <thead><tr><th scope="col">@L["Code"]</th><th scope="col">@L["Result"]</th><th scope="col">@L["What it means"]</th><th scope="col">@L["Technical detail"]</th><th scope="col">@L["What to do"]</th></tr></thead>
        <tbody>
        @foreach (var c in r.Checks)
        {
            <tr><th scope="row"><code>@c.Code</code> @c.Title</th><td><span class="badge @(c.Outcome == Ecp.Recovery.CheckOutcome.Passed ? "ok" : c.Outcome == Ecp.Recovery.CheckOutcome.Warning ? "warn" : "bad")">@(c.Outcome == Ecp.Recovery.CheckOutcome.Failed ? "Blocker" : c.Outcome.ToString())</span>
                @if (c.Outcome == Ecp.Recovery.CheckOutcome.Warning && Model.AcceptedCodes.Contains(c.Code)) { <span class="badge ok">@L["Accepted"]</span> }</td><td>@c.Description</td><td>@c.TechnicalDetail</td><td>@c.Remediation
                @if (c.Outcome == Ecp.Recovery.CheckOutcome.Warning && !Model.AcceptedCodes.Contains(c.Code))
                {
                    <details><summary>@L["Accept this warning"]</summary>
                        <form method="post" asp-page-handler="Accept">
                            <input type="hidden" name="Code" value="@c.Code" /><input type="hidden" name="BackupId" value="@r.BackupId" />
                            <div class="field"><label for="reason-@c.Code">@L["Why it is acceptable (kept on the record)"]</label><input id="reason-@c.Code" name="Reason" maxlength="500" required /></div>
                            <div class="field"><label for="days-@c.Code">@L["Valid for (days, at most 90)"]</label><input id="days-@c.Code" name="ValidDays" type="number" min="1" max="90" value="30" /></div>
                            <div class="actions"><button type="submit">@L["Accept the warning"]</button></div>
                        </form></details>
                }</td></tr>
        }
        </tbody>
    </table>
    </div>
}
<section class="card" aria-labelledby="acc-h">
    <h2 id="acc-h">@L["Accepted warnings"]</h2>
    <p>@L["Accepting a warning records who accepted it, why and until when. It does not remove the warning: the pre-flight still reports Ready with warnings, and evidence counts it as Passed only while every warning has a current acceptance."]</p>
    @if (Model.Acceptances.Count == 0) { <p>@L["Nothing has been accepted."]</p> }
    else
    {
        <div class="table-wrap"><table>
            <caption class="visually-hidden">@L["Accepted warnings"]</caption>
            <thead><tr><th scope="col">@L["Code"]</th><th scope="col">@L["Accepted by"]</th><th scope="col">@L["Reason"]</th><th scope="col">@L["Until"]</th><th scope="col">@L["State"]</th><th scope="col"><span class="visually-hidden">@L["Actions"]</span></th></tr></thead>
            <tbody>
            @foreach (var a in Model.Acceptances)
            {
                <tr><th scope="row"><code>@a.Code</code></th><td>@a.AcceptedByName</td><td>@a.Reason</td><td>@Fmt.DateTime(a.ExpiresUtc)</td><td>@(a.RevokedUtc is not null ? L["Revoked"] : a.Active ? L["Active"] : L["Expired"])</td>
                    <td>@if (a.Active) { <form method="post" asp-page-handler="Revoke"><input type="hidden" name="id" value="@a.Id" /><button type="submit">@L["Revoke"]</button></form> }</td></tr>
            }
            </tbody></table></div>
    }
</section>
<p><a href="/Admin/Operations">@L["Back to Operations"]</a></p>
