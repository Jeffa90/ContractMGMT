@page "/Admin/Packs/Upload"
@model Ecp.Host.Pages.Admin.Packs.UploadModel
@{ ViewData["Title"] = L["Upload a solution pack"].Value; }
<h1>@L["Upload a solution pack"]</h1>
<ol class="wizard-steps" aria-label="@L["Progress"]">
    <li aria-current="step"><span class="visually-hidden">@L["Current step: "]</span>1. @L["Choose the file"]</li><li>2. @L["Check and review"]</li><li>3. @L["Install"]</li>
</ol>
<partial name="_Errors" model="ViewData.ModelState" />
<p class="lede">@L["Choose a solution pack file (.ecpkg) supplied by a publisher you trust. It is checked in a safe holding area first. Nothing is installed and nothing in your organisation changes until you review the result and confirm."]</p>
<form method="post" enctype="multipart/form-data" class="card">
    <div class="field">
        <label for="file">@L["Solution pack file (.ecpkg)"]</label>
        <input id="file" name="file" type="file" accept=".ecpkg" required aria-describedby="file-hint" />
        <p id="file-hint" class="hint">@L["Up to"] @Model.MaxMegabytes @L["MB. A pack contains configuration only: it never contains programs, scripts or database commands, and the platform would refuse it if it did."]</p>
    </div>
    <div class="actions"><button type="submit">@L["Upload and check"]</button> <a class="button secondary" href="/Admin/Packs">@L["Cancel"]</a></div>
    <p class="hint" role="status">@L["Checking a pack takes a few seconds. Please wait after you press the button."]</p>
</form>
<details class="card"><summary>@L["Help: what is checked?"]</summary>
    <ul>
        <li>@L["The file is a safe archive of the expected shape, and nothing has been changed since it was made."]</li>
        <li>@L["Who signed it, and whether you trust that publisher."]</li>
        <li>@L["Whether this version of the platform can use it."]</li>
        <li>@L["That its contents are valid configuration, checked by the same rules as anything you configure yourself."]</li>
    </ul>
</details>
