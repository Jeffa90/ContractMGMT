@page "/Admin/Terminology/Edit"
@model Ecp.Host.Pages.Admin.Terminology.EditModel
@{ ViewData["Title"] = L["Edit the terminology draft"].Value; }
<h1>@L["Edit the terminology draft"]</h1>
<p class="lede">@L["Tick a row to use your own wording for it; leave it unticked to inherit the wording of the pack, then the platform. Saving never publishes. A label changes what people read, never what they may do."]</p>
<partial name="_Errors" model="ViewData.ModelState" />
@if (Model.Form is { } f)
{
    <form method="get" class="card inline-form" aria-label="@L["Choose the locale to edit"]">
        <input type="hidden" name="OrganisationId" value="@f.OrganisationId" />
        <div class="field"><label for="locale-pick">@L["Locale being edited"]</label>
            <select id="locale-pick" name="Locale" aria-describedby="locale-pick-hint">@foreach (var l in f.Locales) { <option value="@l" selected="@(l == f.Locale)">@l</option> }</select>
            <span id="locale-pick-hint" class="hint">@L["Save first: changing the locale shows another locale's rows and does not carry unsaved changes."]</span></div>
        <div class="actions"><button type="submit" class="secondary">@L["Show this locale"]</button></div>
    </form>
    <p>@f.OrganisationName, @L["locale"] <strong>@f.Locale</strong>. @(f.Draft is null ? L["There is no open draft yet; saving starts one."] : L["A draft is open."])</p>
    <form method="post" aria-label="@L["Terminology draft"]">
        <input type="hidden" name="OrganisationId" value="@f.OrganisationId" />
        <input type="hidden" name="Locale" value="@f.Locale" />
        @{ var index = 0; }
        @foreach (var group in f.Rows.GroupBy(r => r.Group))
        {
            <section class="card" aria-labelledby="g-@group.Key.Replace(' ', '-')">
                <h2 id="g-@group.Key.Replace(' ', '-')">@group.Key</h2>
                @foreach (var r in group)
                {
                    var i = index++;
                    var row = Model.Rows[i];
                    <fieldset class="term">
                        <legend><code class="id">@r.Key</code> <span class="hint">@L["inherits"] @r.InheritedSingular / @r.InheritedPlural (@(r.InheritedFrom == Ecp.SharedKernel.TermLayer.Pack ? L["pack"] : L["platform"]))</span></legend>
                        <input type="hidden" name="Rows[@i].Key" value="@r.Key" />
                        <p class="hint">@r.Description</p>
                        <div class="check field"><input id="row-@i-override" name="Rows[@i].Override" type="checkbox" value="true" checked="@row.Override" /><label for="row-@i-override">@L["Use my own wording for {0}", r.Key]</label></div>
                        <div class="field"><label for="row-@i-singular">@L["Singular"]</label><input id="row-@i-singular" name="Rows[@i].Singular" type="text" maxlength="80" value="@row.Singular" placeholder="@r.InheritedSingular" /></div>
                        <div class="field"><label for="row-@i-plural">@L["Plural"]</label><input id="row-@i-plural" name="Rows[@i].Plural" type="text" maxlength="80" value="@row.Plural" placeholder="@r.InheritedPlural" /></div>
                        <details>
                            <summary>@L["Short label, description and help text (optional)"]</summary>
                            <div class="field"><label for="row-@i-short">@L["Short label"]</label><input id="row-@i-short" name="Rows[@i].Short" type="text" maxlength="30" value="@row.Short" /></div>
                            <div class="field"><label for="row-@i-description">@L["Description"]</label><input id="row-@i-description" name="Rows[@i].Description" type="text" maxlength="300" value="@row.Description" /></div>
                            <div class="field"><label for="row-@i-help">@L["Help text"]</label><textarea id="row-@i-help" name="Rows[@i].Help" maxlength="600" rows="2">@row.Help</textarea></div>
                        </details>
                    </fieldset>
                }
            </section>
        }
        <section class="card" aria-labelledby="groups-h">
            <h2 id="groups-h">@L["Approver group names"]</h2>
            <p class="hint">@L["A group key such as the one a workflow names is a stable identifier and is never changed here. Give it a name people can read; leave the name empty to inherit the pack's name, or to show the key. The three empty rows are for groups not listed yet: type the key exactly as the workflow and the role assignments write it."]</p>
            @for (var gi = 0; gi < Model.GroupRows.Count; gi++)
            {
                var g = Model.GroupRows[gi];
                var known = string.IsNullOrEmpty(g.Key) ? null : f.Groups.FirstOrDefault(x => x.Key == g.Key);
                <fieldset class="term">
                    <legend>@(known is null ? L["A group not listed yet"].Value : known.Key)@if (known?.InheritedName is { } inh) { <span class="hint"> @L["inherits"] @inh (@L["pack"])</span> }</legend>
                    @if (known is not null) { <input type="hidden" name="GroupRows[@gi].Key" value="@known.Key" /> }
                    else { <div class="field"><label for="group-@gi-key">@L["Stable group key"]</label><input id="group-@gi-key" name="GroupRows[@gi].Key" type="text" maxlength="100" value="@g.Key" /></div> }
                    <div class="field"><label for="group-@gi-name">@L["Name shown"]</label><input id="group-@gi-name" name="GroupRows[@gi].Name" type="text" maxlength="80" value="@g.Name" placeholder="@known?.InheritedName" /></div>
                    <div class="field"><label for="group-@gi-description">@L["Description (optional)"]</label><input id="group-@gi-description" name="GroupRows[@gi].Description" type="text" maxlength="300" value="@g.Description" /></div>
                </fieldset>
            }
        </section>
        <section class="card" aria-labelledby="roles-h">
            <h2 id="roles-h">@L["Roles offered when assigning"]</h2>
            <p class="hint">@L["Choose which roles appear when someone assigns a role. This only tidies the pickers: nobody loses access, people who hold a hidden role are still listed, and the administrative roles are always offered."]</p>
            @for (var ri = 0; ri < Model.RoleRows.Count; ri++)
            {
                var role = f.Roles.First(x => x.Code == Model.RoleRows[ri].Code);
                <div class="field">
                    <input type="hidden" name="RoleRows[@ri].Code" value="@role.Code" />
                    <label for="role-@ri">@Terms.Role(role.Code) <code class="id">@role.Code</code></label>
                    <select id="role-@ri" name="RoleRows[@ri].Choice">
                        <option value="inherit" selected="@(Model.RoleRows[ri].Choice == "inherit")">@L["Inherit"] (@(role.InheritedOffered ? L["offered"] : L["not offered"]))</option>
                        <option value="offered" selected="@(Model.RoleRows[ri].Choice == "offered")">@L["Offered"]</option>
                        @if (role.Hideable) { <option value="hidden" selected="@(Model.RoleRows[ri].Choice == "hidden")">@L["Not offered"]</option> }
                    </select>
                </div>
            }
        </section>
        <section class="card" aria-labelledby="act-h">
            <h2 id="act-h">@L["Save, check and publish"]</h2>
            <div class="field"><label for="Note">@L["Note for the history (optional)"]</label><input id="Note" name="Note" type="text" maxlength="500" value="@Model.Note" /></div>
            <div class="actions">
                <button type="submit" asp-page-handler="Save">@L["Save the draft"]</button>
                <button type="submit" class="secondary" asp-page-handler="Validate">@L["Save and validate"]</button>
                @if (Model.CanPublish) { <button type="submit" asp-page-handler="Publish">@L["Publish"]</button> }
                <a class="button secondary" href="/Admin/Terminology/Preview?organisationId=@f.OrganisationId&amp;locale=@Uri.EscapeDataString(f.Locale)">@L["Preview"]</a>
            </div>
            <p class="hint">@L["Publishing needs a recent sign-in, and a second person where your installation requires it."]</p>
        </section>
    </form>
    @if (f.Draft is not null)
    {
        <form method="post" asp-page-handler="Discard"><input type="hidden" name="OrganisationId" value="@f.OrganisationId" /><input type="hidden" name="Locale" value="@f.Locale" />
            <div class="actions"><button type="submit" class="secondary">@L["Discard the draft"]</button></div></form>
    }
}
<p><a href="/Admin/Terminology">@L["Back to terminology"]</a></p>
