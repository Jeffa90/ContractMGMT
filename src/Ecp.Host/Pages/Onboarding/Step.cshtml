@page "/Onboarding/Step/{id}"
@model Ecp.Host.Pages.Onboarding.StepModel
@{ ViewData["Title"] = Model.Help.Title; }
@if (Model.Blocked) { <partial name="_OnboardingBlocked" /> return; }
<p><a href="/Onboarding?org=@Model.OrganisationId">&larr; @L["Checklist"]</a></p>
<h1>@Terms.Expand(Model.Help.Title)</h1>
<p class="lede">@Terms.Expand(Model.Help.Purpose)</p>
<p>@L["[[organisation]]"]: <strong>@Model.OrganisationName</strong></p>
@if (!ViewData.ModelState.IsValid)
{
    <div class="error-summary" role="alert" tabindex="-1"><h2>@L["This could not be saved"]</h2>@foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <p>@Terms.Expand(e.ErrorMessage)</p> }</div>
}
@if (Model.Issues.Count > 0)
{
    <div class="error-summary" role="alert" tabindex="-1">
        <h2>@L["Nothing was saved. Fix these lines and try again."]</h2>
        <ul>@foreach (var i in Model.Issues) { <li>@(i.Line > 0 ? $"Line {i.Line}: " : "")@Terms.Expand(i.Message)</li> }</ul>
    </div>
}
<details class="card" open>
    <summary>@L["Help for this step"]</summary>
    <ul>@foreach (var g in Model.Help.Guidance) { <li>@Terms.Expand(g)</li> }</ul>
    @if (Model.Help.Format.Length > 0)
    {
        <p>@L["Columns"]: <code>@Terms.Expand(Model.Help.Format)</code></p>
        <p>@L["Example"]:</p>
        <pre>@Terms.Expand(Model.Help.Example)</pre>
    }
</details>
@if (Model.Help.Id == "pack")
{
    <form method="post">
        <input type="hidden" name="Org" value="@Model.OrganisationId" />
        <div class="field">
            <label for="PackId">@L["[[solution.pack|sentence]]"]</label>
            <select id="PackId" name="PackId" aria-describedby="pack-notes">
                <option value="" selected="@(Model.PackId is null)">@L["None (start from the Blank configuration)"]</option>
                @foreach (var p in Model.Packs) { <option value="@p.PackKey" selected="@(p.PackKey == Model.PackId)">@p.Name() (v@(p.Version))</option> }
            </select>
        </div>
        <div id="pack-notes">
            @if (Model.Packs.Count == 0) { <p class="hint">@L["No [[solution.pack|plural|lower]] are available here. Continue with the Blank configuration, or ask an administrator to install a pack in the Pack Manager."]</p> }
            @foreach (var p in Model.Packs)
            {
                <section class="card" aria-labelledby="pack-@p.PackKey">
                    <h3 id="pack-@p.PackKey">@p.Name() <span class="hint">v@(p.Version)</span></h3>
                    <p>@p.DescriptionText()</p>
                    <dl>
                        <dt>@L["Publisher"]</dt><dd>@p.PublisherName</dd>
                        <dt>@L["Signature"]</dt><dd>@(p.Trust.IsTrusted ? L["Signed by a trusted key"] : L["NOT signed: accepted only because this is a demonstration or test environment"])</dd>
                        <dt>@L["Includes"]</dt><dd>@string.Join(", ", p.Content.Select(c => c.Kind))</dd>
                        @if (p.Capabilities.Count > 0) { <dt>@L["Capabilities"]</dt><dd>@string.Join(", ", p.Capabilities)</dd> }
                        @if (Model.Wording.TryGetValue(p.PackKey, out var w))
                        {
                            <dt>@L["Wording"]</dt>
                            <dd><ul class="plain">@foreach (var (key, label) in w.Examples) { <li><code class="id">@key</code> &rarr; @label</li> }</ul></dd>
                        }
                        else { <dt>@L["Wording"]</dt><dd>@L["The platform's neutral wording (this pack carries none)"]</dd> }
                        <dt>@L["Starting [[category|plural|lower]]"]</dt><dd>@p.Info!.Defaults.Categories.Count</dd>
                        <dt>@L["Starting [[contract.type|plural|lower]]"]</dt><dd>@p.Info.Defaults.ContractTypes.Count</dd>
                    </dl>
                </section>
            }
            <p class="hint">@L["Choosing a pack only prepares drafts for you to review. Nothing takes effect until you validate and publish."]</p>
            <p class="hint">@L["The pack's wording applies as the default as soon as it is chosen, and is also prepared as a terminology draft. You can use it as it is, or adjust labels under"] <a href="/Admin/Terminology?organisationId=@Model.OrganisationId">@L["Administration, Terminology"]</a>@L[". Labels change what people read, never what they may do."]</p>
        </div>
        <div class="check field"><input id="loadDefaults" name="loadDefaults" type="checkbox" value="true" /><label for="loadDefaults">@L["Also add the pack's [[category|plural|lower]] and [[contract.type|plural|lower]] to this draft"]</label></div>
        <div class="actions"><button type="submit">@L["Save"]</button></div>
    </form>
}
else
{
    <form method="post">
        <input type="hidden" name="Org" value="@Model.OrganisationId" />
        <div class="field">
            <label for="Csv">@L["List (one item per line)"]</label>
            <textarea id="Csv" name="Csv" rows="14" spellcheck="false" aria-describedby="csv-hint">@Model.Text</textarea>
            <p class="hint" id="csv-hint">@L["Comma separated. The first line may be the column names. Saving replaces this list in the draft; publishing is a separate step."]</p>
        </div>
        <div class="actions"><button type="submit">@L["Save to draft"]</button></div>
    </form>
}
