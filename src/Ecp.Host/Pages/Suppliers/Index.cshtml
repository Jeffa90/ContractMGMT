@page "/Suppliers"
@model Ecp.Host.Pages.Suppliers.IndexModel
@{ ViewData["Title"] = L["[[supplier|plural]]"].Value; }
<h1>@L["[[supplier|plural]]"]</h1>
<form method="get" class="card">
    <div class="field"><label for="q">@L["Search by name or [[supplier.number]]"]</label><input id="q" name="q" type="text" value="@Model.Q" /></div>
    <button type="submit">@L["Search"]</button>
</form>
@if (Model.CanManage) { <p><a class="button" href="/Suppliers/Create">@L["Add [[supplier|lower|a]]"]</a></p> }
<div class="table-wrap">
<table>
    <caption class="visually-hidden">@L["[[supplier|plural]]"]</caption>
    <thead><tr><th scope="col">@L["Name"]</th><th scope="col">@L["[[supplier.number]]"]</th><th scope="col">@L["[[supplier.tax.id]]"]</th><th scope="col">@L["[[organisation]]"]</th></tr></thead>
    <tbody>
    @foreach (var s in Model.Suppliers) { <tr><th scope="row"><a href="/Suppliers/Details/@s.Id">@s.Name</a></th><td>@s.VendorNumber</td><td>@s.Abn</td><td>@Model.OrganisationName(s.OrganisationId)</td></tr> }
    @if (Model.Suppliers.Count == 0) { <tr><td colspan="4">@L["No [[supplier|plural|lower]] are visible to you."]</td></tr> }
    </tbody>
</table>
</div>
