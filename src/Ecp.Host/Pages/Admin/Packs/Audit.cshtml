@page "/Admin/Packs/Audit"
@model Ecp.Host.Pages.Admin.Packs.AuditModel
@{ ViewData["Title"] = L["Solution pack history"].Value; }
<h1>@L["Solution pack history"]</h1>
<p class="lede">@L["Every upload, check, install, retirement, assignment and change to trusted publishers, with who did it and what happened. Entries cannot be edited."]</p>
<div class="table-wrap"><table>
    <caption class="visually-hidden">@L["Pack Manager history"]</caption>
    <thead><tr><th scope="col">@L["When (UTC)"]</th><th scope="col">@L["What"]</th><th scope="col">@L["Who"]</th><th scope="col">@L["Outcome"]</th><th scope="col">@L["Subject"]</th><th scope="col">@L["Reason"]</th></tr></thead>
    <tbody>
    @foreach (var a in Model.Items.Items)
    {
        <tr><td>@a.OccurredUtc.ToString("u")</td><td>@a.Action</td><td>@(a.Actor ?? "-")</td><td>@a.Outcome</td><td>@a.Subject</td><td>@(a.Reason ?? "-")</td></tr>
    }
    @if (Model.Items.Items.Count == 0) { <tr><td colspan="6">@L["Nothing has been recorded yet."]</td></tr> }
    </tbody>
</table></div>
@{ var pages = (int)Math.Ceiling(Model.Items.Total / (double)Model.Items.PageSize); }
@if (pages > 1)
{
    <nav class="pager" aria-label="@L["Pages"]">
        @if (Model.Items.Page > 1) { <a href="/Admin/Packs/Audit?page=@(Model.Items.Page - 1)">@L["Previous"]</a> }
        <span>@L["Page"] @Model.Items.Page @L["of"] @pages</span>
        @if (Model.Items.Page < pages) { <a href="/Admin/Packs/Audit?page=@(Model.Items.Page + 1)">@L["Next"]</a> }
    </nav>
}
<p><a href="/Admin/Packs">@L["Back to solution packs"]</a></p>
