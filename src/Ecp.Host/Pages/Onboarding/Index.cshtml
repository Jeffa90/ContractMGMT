@page "/Onboarding"
@model Ecp.Host.Pages.Onboarding.IndexModel
@{ ViewData["Title"] = L["[[organisation]] onboarding"].Value; }
@if (Model.Blocked) { <partial name="_OnboardingBlocked" /> return; }
<h1>@L["[[organisation]] onboarding"]</h1>
<p class="lede">@L["Describe how the [[organisation|lower]] is structured, who owns what and who may see what. You work on a draft, check it, preview its effect, and only then publish. Every release is versioned and can be rolled back."]</p>
@if (Model.Organisations.Count > 1)
{
    <form method="get" class="card">
        <div class="field"><label for="org">@L["[[organisation]]"]</label>
            <select id="org" name="org">@foreach (var o in Model.Organisations) { <option value="@o.Id" selected="@(o.Id == Model.OrganisationId)">@o.Name</option> }</select></div>
        <button type="submit" class="secondary">@L["Switch [[organisation|lower]]"]</button>
    </form>
}
@if (Model.Ready is { } readyToUse) { <partial name="_ReadyToUse" model="readyToUse" /> }
<p>@L["[[organisation]]"]: <strong>@Model.OrganisationName</strong>. @(Model.State!.CurrentRelease is { } r ? $"Current release: {r}." : "Nothing has been published yet.")</p>
@if (Model.Readiness is { } ready)
{
    <section class="card" aria-labelledby="ready-h">
        <h2 id="ready-h">@L["Set-up checklist"]</h2>
        <p class="lede">@Terms.Expand("What the [[organisation|lower]] needs before it is ready to use, in the order to do it. What is Required depends on the starting configuration you chose; each item turns Complete by itself when it is true.")</p>
        @if (ready.CanPublish)
        {
            <p class="flash" role="status">@L["Every required item is complete. You can review the draft and publish."]</p>
        }
        else
        {
            <p class="flash warn" role="status"><strong>@L["Not ready to publish yet."]</strong> @ready.BlockingItems.Count @(ready.BlockingItems.Count == 1 ? L["required item is"].Value : L["required items are"].Value) @L["still open:"] @string.Join("; ", ready.BlockingItems.Select(i => Terms.Expand(i.Title)))</p>
        }
        <ol class="steps">
        @foreach (var item in ready.Items)
        {
            <li>
                <span class="badge @(item.State == Ecp.Setup.Onboarding.ReadinessState.Complete ? "ok" : item.State == Ecp.Setup.Onboarding.ReadinessState.NeedsAttention ? "bad" : "")">@(item.State switch { Ecp.Setup.Onboarding.ReadinessState.Complete => L["Complete"].Value, Ecp.Setup.Onboarding.ReadinessState.NeedsAttention => L["Needs attention"].Value, Ecp.Setup.Onboarding.ReadinessState.NotApplicable => L["Not used here"].Value, _ => L["To do"].Value })</span>
                <span class="badge @(item.Level == Ecp.Setup.Onboarding.ReadinessLevel.Required ? "warn" : "")">@(item.Level switch { Ecp.Setup.Onboarding.ReadinessLevel.Required => L["Required"].Value, Ecp.Setup.Onboarding.ReadinessLevel.Recommended => L["Recommended"].Value, _ => L["Optional"].Value })</span>
                <a href="@item.FixHref@(item.FixHref.StartsWith("/Onboarding") ? "?org=" + Model.OrganisationId : "")">@Terms.Expand(item.Title)</a>
                <span class="hint">@Terms.Expand(item.Detail)</span>
            </li>
        }
        </ol>
        @if (ready.PackKey is not null) { <p class="hint">@Terms.Expand($"Required, Recommended and Optional come from the starting configuration “{ready.PackKey}”.") @(ready.PackDefinesRequirements ? "" : L["It does not set its own, so only the platform's safety items are Required."].Value)</p> }
    </section>
}
<h2>@L["Draft sections"]</h2>
<p class="hint">@L["These are the bulk-entry sections of the draft that publishing applies (CSV, advanced). Most people use the checklist above and the screens it links to."]</p>
<ol class="steps">
@foreach (var item in Model.Checklist)
{
    <li>
        <span class="badge @(item.Status is "Entered" or "Chosen" or "Valid" ? "ok" : item.Status == "Needs attention" ? "bad" : "")">@Terms.Expand(item.Status)</span>
        <a href="/Onboarding/@(item.Id == "review" ? "Review" : "Step/" + item.Id)?org=@Model.OrganisationId">@Terms.Expand(item.Title)</a>
        <span class="hint">@Terms.Expand(item.Detail)</span>
    </li>
}
</ol>
