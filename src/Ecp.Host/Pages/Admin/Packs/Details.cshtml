@page "/Admin/Packs/Details"
@model Ecp.Host.Pages.Admin.Packs.DetailsModel
@{
    var p = Model.Pack;
    ViewData["Title"] = (p is null ? L["[[solution.pack|sentence]]"].Value : p.Entry.Name());
}
@if (p is not null)
{
    var e = p.Entry;
    <h1>@e.Name() <span class="hint">v@(e.Version)</span></h1>
    <p class="lede">@e.DescriptionText()</p>
    <partial name="_Errors" model="ViewData.ModelState" />
    @if (!e.Trust.IsTrusted && e.Trust.IsAcceptable)
    {
        <div class="alert warn" role="alert"><strong>@L["This pack is NOT signed."]</strong> @L["It is accepted here only because this is a demonstration or test environment that allows unsigned synthetic packs. Production would refuse it."]</div>
    }
    @foreach (var issue in e.AllIssues)
    {
        <div class="alert @(issue.IsError ? "bad" : "warn")" role="status"><strong>@issue.Code</strong>: @issue.Message @if (issue.Remediation is not null) { <span>@issue.Remediation</span> }</div>
    }
    <section class="card" aria-labelledby="about-h">
        <h2 id="about-h">@L["About this pack"]</h2>
        <dl class="facts">
            <dt>@L["Pack key"]</dt><dd>@e.PackKey</dd>
            <dt>@L["Version"]</dt><dd>@e.Version</dd>
            <dt>@L["Publisher"]</dt><dd>@e.PublisherName (@e.PublisherId)</dd>
            <dt>@L["Source"]</dt><dd>@(e.IsShipped ? L["Shipped with this installation (read-only)"] : L["Installed by an administrator"])</dd>
            <dt>@L["Signature"]</dt><dd>@(e.Trust.IsTrusted ? L["Signed by a trusted key"] : e.Trust.IsAcceptable ? L["Not signed (accepted for demonstration or test only)"] : L["Not trusted"]) @if (e.Trust.KeyId is not null) { <span class="hint">(@L["key"] @e.Trust.KeyId, @e.Trust.Algorithm)</span> }</dd>
            <dt>@L["Compatible with this platform"]</dt><dd>@(e.IsCompatible ? L["Yes"] : L["No"])</dd>
            <dt>@L["Capabilities"]</dt><dd>@(e.Capabilities.Count == 0 ? "-" : string.Join(", ", e.Capabilities))</dd>
            <dt>@L["Package identifier"]</dt><dd>@e.PackageId</dd>
            <dt>@L["Package checksum (SHA-256)"]</dt><dd><code>@e.PackageSha256</code></dd>
        </dl>
    </section>
    <section class="card" aria-labelledby="inc-h">
        <h2 id="inc-h">@L["What this pack contains"]</h2>
        <div class="table-wrap"><table>
            <caption class="visually-hidden">@L["Contents"]</caption>
            <thead><tr><th scope="col">@L["Kind"]</th><th scope="col">@L["Applies to"]</th><th scope="col">@L["Required"]</th><th scope="col">@L["Format version"]</th></tr></thead>
            <tbody>@foreach (var c in e.Content) { <tr><td>@c.Kind</td><td>@c.Scope</td><td>@(c.Required ? L["Yes"] : L["No"])</td><td>@c.SchemaVersion</td></tr> }</tbody>
        </table></div>
        @if (e.Info is { } info) { <p>@info.Defaults.Categories.Count @L["starting [[category|plural|lower]] and"] @info.Defaults.ContractTypes.Count @L["starting [[contract.type|plural|lower]]."]</p> }
    </section>
    <section class="card" aria-labelledby="use-h">
        <h2 id="use-h">@L["[[organisation|plural]] using this pack"]</h2>
        @if (p.Organisations.Count == 0) { <p>@L["No [[organisation|lower]] uses this pack."]</p> }
        else { <ul>@foreach (var o in p.Organisations) { <li>@o.Name @if (o.Version is not null) { <span class="hint">(v@(o.Version))</span> }</li> }</ul> }
        @if (p.OtherVersions.Count > 0)
        {
            <h3>@L["Other versions"]</h3>
            <ul>@foreach (var v in p.OtherVersions) { <li><a href="/Admin/Packs/Details?key=@Uri.EscapeDataString(v.PackKey)&amp;version=@Uri.EscapeDataString(v.Version)">v@(v.Version)</a></li> }</ul>
        }
    </section>
    <div class="actions">
        @if (e.IsUsable) { <a class="button" href="/Admin/Packs/Assign?key=@Uri.EscapeDataString(e.PackKey)&amp;version=@Uri.EscapeDataString(e.Version)">@L["Use for [[organisation|lower|a]]"]</a> }
        <a class="button secondary" href="/Admin/Packs">@L["Back to [[solution.pack|plural|lower]]"]</a>
    </div>
    @if (!e.IsShipped)
    {
        <section class="card" aria-labelledby="ret-h">
            <h2 id="ret-h">@(e.Retired ? L["Retired"] : L["Retire this version"])</h2>
            <form method="post" asp-page-handler="@(e.Retired ? "Reinstate" : "Retire")">
                <input type="hidden" name="Key" value="@e.PackKey" /><input type="hidden" name="Version" value="@e.Version" />
                @if (!e.Retired)
                {
                    <p class="hint">@L["A retired version cannot be given to more [[organisation|plural|lower]]. [[organisation|plural]] already using it keep it."]</p>
                    <div class="field"><label for="Reason">@L["Reason (kept in the history)"]</label><input id="Reason" name="Reason" type="text" maxlength="500" /></div>
                }
                <div class="actions"><button type="submit">@(e.Retired ? L["Make this version available again"] : L["Retire this version"])</button></div>
            </form>
        </section>
    }
}
