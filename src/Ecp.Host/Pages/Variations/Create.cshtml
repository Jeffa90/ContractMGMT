@page "/Variations/Create"
@model Ecp.Host.Pages.Variations.CreateModel
@{ ViewData["Title"] = L["Start [[variation|a]]"].Value; }
<h1>@L["Start [[variation|a]]"]</h1>
<p class="lede">@L["[[variation|a|cap]] is the way an Effective [[agreement|lower]] changes. The [[agreement|lower]]"] <a href="/Contracts/Details/@Model.Contract.Id">@Model.Contract.AgreementReference</a> @L["stays locked and unchanged until the [[variation]] is approved and applied."]</p>
<partial name="_Errors" model="ViewData.ModelState" />
@{ ViewData["Labels"] = Model.Labels; }
<form method="post">
    <input type="hidden" name="ContractId" value="@Model.ContractId" />
    <partial name="_VariationFields" model="(Model.Form, Model.Fields, Model.Current, (IReadOnlyDictionary<string, string?>)new Dictionary<string, string?>())" />
    <div class="actions"><button type="submit">@L["Draft the [[variation]]"]</button> <a class="button secondary" href="/Contracts/Details/@Model.Contract.Id">@L["Cancel"]</a></div>
</form>
