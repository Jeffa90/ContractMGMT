{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Ecp": {
    "Mode": "Demo",
    "DemoTenantResolution": true,
    "DemoSeed": true,
    "DemoTenantName": "Demo Tenant A",
    "DataDirectory": "data",
    "DefaultPackId": "",
    "Packs": {
      "ShippedDirectory": "",
      "StorageDirectory": "",
      "AllowUnsignedSyntheticPacks": false,
      "TrustFile": ""
    },
    "Recovery": {
      "BackupDirectory": "",
      "SqlServerBackupDirectory": "",
      "RestoreTargetDirectory": "",
      "AdminConnectionStringRef": "",
      "EncryptionCertificate": "",
      "StorageProtection": "",
      "CopyOnly": true,
      "TableChecksums": true,
      "StaleBackupDays": 7
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/ecp-demo.db",
    "ConnectionStringRef": "",
    "AutoMigrate": true
  },
  "Documents": { "MaxFileBytes": 104857600, "AllowSkippedScan": false },
  "Migration": { "ChunkSize": 500, "MaxUploadBytes": 2147483648 }
