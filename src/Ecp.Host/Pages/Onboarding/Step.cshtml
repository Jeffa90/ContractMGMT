@page "/Onboarding/Step/{id}"
@model Ecp.Host.Pages.Onboarding.StepModel
@{ ViewData["Title"] = Model.Help.Title; }
@if (Model.Blocked) { <partial name="_OnboardingBlocked" /> return; }
<p><a href="/Onboarding?org=@Model.OrganisationId">&larr; @L["Checklist"]</a></p>
<h1>@Model.Help.Title</h1>
<p class="lede">@Model.Help.Purpose</p>
<p>@L["Organisation"]: <strong>@Model.OrganisationName</strong></p>
@if (!ViewData.ModelState.IsValid)
{
    <div class="error-summary" role="alert" tabindex="-1"><h2>@L["This could not be saved"]</h2>@foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <p>@e.ErrorMessage</p> }</div>
}
@if (Model.Issues.Count > 0)
{
    <div class="error-summary" role="alert" tabindex="-1">
        <h2>@L["Nothing was saved. Fix these lines and try again."]</h2>
        <ul>@foreach (var i in Model.Issues) { <li>@(i.Line > 0 ? $"Line {i.Line}: " : "")@i.Message</li> }</ul>
    </div>
}
<details class="card" open>
    <summary>@L["Help for this step"]</summary>
    <ul>@foreach (var g in Model.Help.Guidance) { <li>@g</li> }</ul>
    @if (Model.Help.Format.Length > 0)
    {
        <p>@L["Columns"]: <code>@Model.Help.Format</code></p>
        <p>@L["Example"]:</p>
        <pre>@Model.Help.Example</pre>
    }
</details>
@if (Model.Help.Id == "pack")
{
    <form method="post">
        <input type="hidden" name="Org" value="@Model.OrganisationId" />
        <div class="field">
            <label for="PackId">@L["Solution pack"]</label>
            <select id="PackId" name="PackId">
                <option value="" selected="@(Model.PackId is null)">@L["None"]</option>
                @foreach (var p in Model.Packs) { <option value="@p.PackId" selected="@(p.PackId == Model.PackId)">@p.Name (v@(p.Version))</option> }
            </select>
        </div>
        @foreach (var p in Model.Packs) { <p class="hint">@p.Name: @p.Description</p> }
        <div class="check field"><input id="loadDefaults" name="loadDefaults" type="checkbox" value="true" /><label for="loadDefaults">@L["Also add the pack's categories and contract types to this draft"]</label></div>
        <div class="actions"><button type="submit">@L["Save"]</button></div>
    </form>
}
else
{
    <form method="post">
        <input type="hidden" name="Org" value="@Model.OrganisationId" />
        <div class="field">
            <label for="Csv">@L["List (one item per line)"]</label>
            <textarea id="Csv" name="Csv" rows="14" spellcheck="false" aria-describedby="csv-hint">@Model.Text</textarea>
            <p class="hint" id="csv-hint">@L["Comma separated. The first line may be the column names. Saving replaces this list in the draft; publishing is a separate step."]</p>
        </div>
        <div class="actions"><button type="submit">@L["Save to draft"]</button></div>
    </form>
}
