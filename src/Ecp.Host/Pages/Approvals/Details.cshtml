@page "/Approvals/Details/{id:guid}"
@model Ecp.Host.Pages.Approvals.DetailsModel
@using Ecp.Lifecycle
@{ ViewData["Title"] = L["Register authorisation"].Value + " " + Model.Approval.AgreementReference; var r = Model.Approval; var s = r.Snapshot; }
<h1>@L["Register authorisation"]: @r.Title</h1>
<p><span class="badge">@r.AgreementReference</span> <span class="badge @(r.Status == Ecp.Lifecycle.Domain.ApprovalStatus.Pending ? "warn" : r.Status == Ecp.Lifecycle.Domain.ApprovalStatus.Approved ? "ok" : "")">@r.Status</span> <span class="badge">@s.Classification</span></p>
<partial name="_Errors" model="ViewData.ModelState" />

@if (r.Status == Ecp.Lifecycle.Domain.ApprovalStatus.Pending)
{
    <section class="card" aria-labelledby="dec-h">
        <h2 id="dec-h">@L["Your decision"]</h2>
        @if (r.CanApprove)
        {
            <form method="post">
                <input type="hidden" name="ClientRequestId" value="@Model.ClientRequestId" />
                <div class="field"><label for="cmt">@L["Comment (required to reject)"]</label><textarea id="cmt" name="Comment" rows="3" maxlength="4000"></textarea></div>
                <div class="actions">
                    <button type="submit" asp-page-handler="Approve">@L["Approve"]</button>
                    <button type="submit" asp-page-handler="Reject" class="secondary">@L["Reject"]</button>
                </div>
                <p class="hint">@L["Approving stamps the Registered Date (UTC), makes the agreement Effective and locks it. Whoever responds first decides; the second response is refused."]</p>
            </form>
        }
        else { <p class="flash warn" role="status">@r.CannotBecause</p> }
    </section>
}
else if (r.Decision is { } d)
{
    <section class="card" aria-labelledby="dec-h">
        <h2 id="dec-h">@L["Decision"]</h2>
        <dl class="facts">
            <dt>@L["Decision"]</dt><dd>@d.Status</dd>
            <dt>@L["Decided by"]</dt><dd>@d.DecidedByName (@d.DecidedAsRole) @if (d.OnBehalfOfName is { } o) { <span>@L["on behalf of"] @o</span> }</dd>
            <dt>@L["Decided"]</dt><dd>@d.DecidedUtc?.ToString("yyyy-MM-dd HH:mm") UTC</dd>
            @if (d.Comment is { Length: > 0 }) { <dt>@L["Comment"]</dt><dd>@d.Comment</dd> }
        </dl>
    </section>
}

@if (r.Plan is { } plan)
{
    <section class="card" aria-labelledby="plan-h">
        <h2 id="plan-h">@L["Approval steps"]</h2>
        <p>@L["This request is approved through the approval matrix"] <code>@plan.MatrixCode</code> (@plan.MatrixName, @L["release"] @plan.Release, @L["resolved for"] @plan.EffectiveDate.ToString("yyyy-MM-dd")). <span class="badge @(plan.Status == "Approved" ? "ok" : plan.Status == "Rejected" ? "" : "warn")">@plan.Status</span>
            <span class="hint">@L["The steps and people were fixed when it was submitted; later changes to the matrix do not alter it."]</span></p>
        @if (plan.YourPart is { } part) { <p class="flash" role="status">@L["Your part"]: <strong>@part</strong></p> }
        else if (r.Status == Ecp.Lifecycle.Domain.ApprovalStatus.Pending && plan.YourPartNote is { } note) { <p class="hint">@note</p> }
        <div class="table-wrap"><table>
            <caption class="visually-hidden">@L["Approval steps"]</caption>
            <thead><tr><th scope="col">@L["Stage"]</th><th scope="col">@L["Step"]</th><th scope="col">@L["State"]</th><th scope="col">@L["Group"]</th><th scope="col">@L["How they respond"]</th><th scope="col">@L["Who can respond"]</th><th scope="col">@L["Responses"]</th><th scope="col">@L["Still waiting on"]</th></tr></thead>
            <tbody>
            @foreach (var st in plan.Steps.OrderBy(x => x.Stage))
            {
                <tr><td>@st.Stage</td><th scope="row">@st.Display</th><td><span class="badge @(st.Status == "Satisfied" ? "ok" : st.Status == "Open" ? "warn" : "")">@st.Status</span></td><td>@st.ApproverGroup@(st.BackupGroup is { } bg ? $" + {bg}" : "")</td>
                    <td>@(st.Mode == "AllRequired" ? L["Every named approver"] : L["First response wins"])</td>
                    <td><ul class="plain">@foreach (var a in st.Approvers) { <li>@a.Name <span class="badge">@a.Role</span>@if (a.OnBehalfOfName is { } ob) { <span class="hint"> @L["for"] @ob</span> }</li> }</ul></td>
                    <td><ul class="plain">@foreach (var rs in st.Responses) { <li>@(rs.Approved ? L["Approved"] : L["Rejected"]) @L["by"] @rs.Name@(rs.OnBehalfOfName is { } rob ? $" ({L["for"]} {rob})" : "") @rs.RespondedUtc.ToString("yyyy-MM-dd HH:mm") UTC@(rs.Comment is { Length: > 0 } c ? ": " + c : "")</li> }</ul></td>
                    <td>@(st.Outstanding.Count == 0 ? "-" : string.Join(", ", st.Outstanding))</td></tr>
            }
            </tbody>
        </table></div>
        @if (plan.Explanations is { } explanations && plan.Trace is { } trace)
        {
            <details>
                <summary>@L["Why these people, and how the plan was reached (for matrix administrators)"]</summary>
                <div class="table-wrap"><table>
                    <caption class="visually-hidden">@L["Why each person was included or left out"]</caption>
                    <thead><tr><th scope="col">@L["Step"]</th><th scope="col">@L["Person"]</th><th scope="col">@L["Decision"]</th><th scope="col">@L["Why"]</th></tr></thead>
                    <tbody>@foreach (var e in explanations) { <tr><td>@e.StepDisplay</td><th scope="row">@e.Name</th><td>@(e.Included ? L["Included"] : L["Left out"])</td><td>@e.Summary @foreach (var why in e.Reasons) { <div>@why</div> }</td></tr> }</tbody>
                </table></div>
                <div class="table-wrap"><table>
                    <caption class="visually-hidden">@L["Resolution trace"]</caption>
                    <thead><tr><th scope="col">#</th><th scope="col">@L["Stage"]</th><th scope="col">@L["Outcome"]</th><th scope="col">@L["What happened"]</th></tr></thead>
                    <tbody>@foreach (var t in trace) { <tr><td>@t.Sequence</td><td>@t.Stage</td><td>@t.Outcome</td><td>@t.Message</td></tr> }</tbody>
                </table></div>
            </details>
        }
    </section>
}

<section class="card" aria-labelledby="snap-h">
    <h2 id="snap-h">@L["What was submitted"]</h2>
    <p class="hint">@L["This is a frozen record of what the approver relied on at submission. It does not change afterwards."] @if (!r.SnapshotIntact) { <strong class="error">@L["The stored snapshot does not match its checksum."]</strong> }</p>
    <dl class="facts">
        <dt>@L["Agreement"]</dt><dd>@s.AgreementReference @if (s.VariationReference is { } v) { <span>(@L["Variation"] @v)</span> }</dd>
        <dt>@L["Supplier"]</dt><dd>@s.SupplierName</dd><dt>@L["Category"]</dt><dd>@s.CategoryName</dd>
        <dt>@L["Value"]</dt><dd>@(s.EstimatedValue is { } val ? $"{val:N2} {s.CurrencyCode}" : "-")</dd>
        <dt>@L["Start / End"]</dt><dd>@(s.StartDate ?? "-") / @(s.EndDate ?? "-")</dd>
        <dt>@L["Review date"]</dt><dd>@(s.ReviewDate ?? "-")</dd>
        <dt>@L["Legal review"]</dt><dd>@(s.LegalStatus ?? (s.LegalReviewRequired ? "Required" : "Not required")) @if (s.LegalRounds > 0) { <span>(@s.LegalRounds @L["round(s)"]@(s.LegalClearedBy is { } cb ? ", " + L["cleared by"].Value + " " + cb : ""))</span> }</dd>
        <dt>@L["Execution"]</dt><dd>@(s.ExecutionProvider ?? "-") @(s.EnvelopeId is { } env ? $"· envelope {env}" : "") @(s.ExecutionStatus is { } es ? $"· {es}" : "")</dd>
        <dt>@L["Submitted by"]</dt><dd>@r.SubmittedByName, @r.SubmittedUtc.ToString("yyyy-MM-dd HH:mm") UTC</dd>
        <dt>@L["Workflow"]</dt><dd><code>@s.WorkflowRef</code></dd>
        <dt>@L["Snapshot checksum"]</dt><dd><code>@r.SnapshotSha256</code></dd>
    </dl>
    @if (s.ProposedChanges is { Count: > 0 } changes)
    {
        <h3>@L["Proposed changes"]</h3>
        <div class="table-wrap"><table><thead><tr><th scope="col">@L["Field"]</th><th scope="col">@L["Now"]</th><th scope="col">@L["Proposed"]</th></tr></thead>
        <tbody>@foreach (var (field, proposed) in changes) { <tr><th scope="row">@field</th><td>@(s.CurrentValues?.GetValueOrDefault(field) ?? "-")</td><td>@(proposed ?? "-")</td></tr> }</tbody></table></div>
    }
</section>

<section class="card" aria-labelledby="doc-h">
    <h2 id="doc-h">@L["Executed copy"]</h2>
    @if (r.ExecutedDocument is { } doc)
    {
        <p>@if (doc.CanDownload) { <a href="/Documents/Download/@doc.DocumentId">@doc.Title</a> } else { @doc.Title } <span class="hint">@doc.FileName &middot; SHA-256 <code>@doc.Sha256</code></span></p>
    }
    else { <p class="hint">@L["The executed copy is not available to you."]</p> }
</section>

@if (r.Plan is null)
{
    <section aria-labelledby="who-h">
        <h2 id="who-h">@L["Who can decide"]</h2>
        <ul class="plain">@foreach (var e in r.Eligible) { <li>@e.DisplayName <span class="badge">@(e.IsBackup ? L["Backup"] : L["Primary"])</span></li> }</ul>
        <p class="hint">@L["A backup approver is notified together with the primary approver. The first response stands."]</p>
    </section>
}

<section aria-labelledby="hist-h">
    <h2 id="hist-h">@L["Decision history for this agreement"]</h2>
    <div class="table-wrap"><table>
        <thead><tr><th scope="col">@L["Submitted"]</th><th scope="col">@L["By"]</th><th scope="col">@L["Outcome"]</th><th scope="col">@L["Decided by"]</th><th scope="col">@L["Comment"]</th></tr></thead>
        <tbody>
        @foreach (var h in r.History)
        {
            <tr><td>@h.SubmittedUtc.ToString("yyyy-MM-dd HH:mm") UTC</td><td>@h.SubmittedByName</td><td>@h.Status</td><td>@(h.DecidedByName ?? "-") @(h.OnBehalfOfName is { } ob ? $"(for {ob})" : "")</td><td>@h.Comment</td></tr>
        }
        </tbody>
    </table></div>
</section>
<p><a href="/Contracts/Details/@r.ContractId">@L["Open the agreement"]</a> &middot; <a href="/Approvals">&larr; @L["Pending approvals"]</a></p>
